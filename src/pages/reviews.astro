---
import MainLayout from "../layouts/MainLayout.astro";

//md data
import { getCollection } from "astro:content";

const reviewPost = await getCollection("reviews");

//image compression
import { Image } from "astro:assets";
import hero from "../images/hero/hero2.jpg";
import reviews from "../images/media/testimonial.jpg";

//icons
import { Icon } from "astro-icon";

const {
  title,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang="en"
  pageIndex="reviews"
  pageIndexEn="reviews"
  title="Reviews | Elamio Yachting"
  charset={charset}
  description="See what other people have to say about us | Elamio Yachting"
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
  noindex
  nofollow
>
  <div class="hero_content txtOnDark txt-center flex-center">
    <div class="black"></div>
    <Image
      src={reviews}
      alt="boat"
      format="avif"
      loading="lazy"
      class="hero-img"
    />
    <div class="heroContainer-default">
      <h1 class="h1">Reviews</h1>

      <h2 class="body">What other people have to say about us?</h2>
    </div>
  </div>

  <div class="section wrapper-medium center">
    <ul class="">
      {
        reviewPost.map((i) => (
          <li class="padb-900 justify">
            <div class="txtOnDark center bg-dark-50 padlr-300 padt-100 padb-100">
              <p class="padb-400 body">{i.data.full}</p>
              <p class="script-font padb-100">{i.data.name}</p>
              <p class="upper font-heading clr-prim-acc">{i.data.from}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</MainLayout>
