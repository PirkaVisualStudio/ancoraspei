---
import MainLayout from "../../layouts/MainLayout.astro";
import GalleryPershing from "../../components/GalleryPershing.astro";

//image compression
import { Image } from "astro:assets";

import pershing1 from "../../images/galleries/pershing46/img1.jpeg";
import pershing2 from "../../images/galleries/pershing46/img2.jpg";
import pershing3 from "../../images/galleries/pershing46/img3.jpg";
import pershing4 from "../../images/galleries/pershing46/img4.jpg";
import pershing5 from "../../images/galleries/pershing46/img5.jpg";
import pershing6 from "../../images/galleries/pershing46/img6.jpg";
import pershing7 from "../../images/galleries/pershing46/img7.jpg";
import pershing8 from "../../images/galleries/pershing46/img8.jpg";
import pershing9 from "../../images/galleries/pershing46/img9.jpg";
import pershing10 from "../../images/galleries/pershing46/img10.jpg";
import pershing11 from "../../images/galleries/pershing46/img11.jpg";
import pershing12 from "../../images/galleries/pershing46/img12.jpg";
import pershing13 from "../../images/galleries/pershing46/img13.jpg";
import pershing14 from "../../images/galleries/pershing46/img14.jpg";
import pershing15 from "../../images/galleries/pershing46/img15.jpg";

//icons
import { Icon } from "astro-icon";

const {
  title,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang="en"
  pageIndex="boat-fleet"
  pageIndexEn="boat-fleet"
  title="Pershing 46 | Elamio Yachting"
  charset={charset}
  description="Check out our Pershing 46 boat and details | Elamio Yachting"
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
  noindex
  nofollow
>
  <div class="section wrapper txtOnDark mart-900 center">
    <h1 class="h1 txt-center padt-200 padb-100">Pershing 46</h1>
    <h2 class="txt-label txt-center padb-900">Karla Jane</h2>
    <div class="flex-rows">
      <div class="full">
        <Image
          src={pershing1}
          alt="pershing 46 elamio"
          format="avif"
          loading="lazy"
          class="boat-img hidden-fade"
        />
      </div>
      <div class="flex-center boat-specs">
        <p class="h5">
          Engines: <span class="clr-prim-acc body-large normal-weight"
            >2 MAN 800 hp</span
          >
        </p>
        <p class="h5">
          Top Speed: <span
            class="clr-prim-acc body-large normal-weight hidden-interval"
          >
            knots</span
          >
        </p>
        <p class="h5">
          Consumption: <span class="clr-prim-acc body-large normal-weight"
            >180L @ 27kts</span
          >
        </p>
      </div>
    </div>

    <!-- about -->
    <div class="section txtOnDark center txt-center flex-columns">
      <div class="flex-left boat-text-l">
        <h2 class="h2">About</h2>
        <div class="line-acc-full mart-200"></div>
        <p class="body padt-200 padb-200">
          Welcome to Pershing 46, a luxurious motor yacht that was built for
          hedonism and comfort, combined with the ultimate elegance, quality of
          construction and incredible performance. Karla Jane is an example of
          intelligent yacht construction, a perfect harmony of performance and
          style that will make your day at sea memorable. Book this diminutive
          luxury yacht from our fleet and experience the Adriatic Sea to the
          fullest with our “Karla Jane” beauty!
        </p>
        <a href="/media/EY-Pershing46-brochure.pdf" target="_blank"
          ><div class="btnFill marb-200">BROCHURE</div></a
        >
      </div>

      <div class="flex-right">
        <Image
          src={pershing2}
          alt="pershing46"
          format="avif"
          loading="lazy"
          class="flex-img hidden-fade"
        />
      </div>
    </div>

    <!-- charter -->
    <div class="section txtOnDark center txt-center flex-columns-reverse">
      <div class="flex-left">
        <Image
          src={pershing3}
          alt="pershing46"
          format="avif"
          loading="lazy"
          class="flex-img hidden-fade"
        />
      </div>

      <div class="flex-right boat-text-r">
        <h2 class="h2">Charter</h2>
        <div class="line-acc-full mart-200"></div>
        <p class="body padt-200 padb-200">
          It provides a spacious accommodation for four guests in two cabins
          with separate bathrooms. However, if spending nights in marinas, there
          is also a possibility for the crew to sleep on the shore, so the
          guests could enjoy peace and tranquility to the fullest. With the crew
          on the shore, there is an extra guest cabin with en-suite that can
          accomodate another two people.
        </p>
      </div>
    </div>

    <!-- DAILY TRIPS AND TRANSFERS -->
    <div class="section txtOnDark center txt-center flex-columns">
      <div class="flex-left boat-text-l">
        <h2 class="h2 left">Daily trips and transfers</h2>
        <div class="line-acc-full mart-200"></div>
        <p class="body padt-200 padb-200">
          With abundance of space and comfort, ''Karla Jane'' can accommodate up
          to 10 people. Strong haul and powerful engines make this boat rather
          stable and strong on the sea. Therefore, trips and transfers can truly
          be enjoyed to the fullest on this yacht. Well experienced captain and
          educated crew are there to fulfill all of your wishes while
          introducing you to the beauty of Adriatic coast and its hidden jewels
          they are familiar with due to their long experience in the industry
          and love for the Adriatic Sea.
        </p>
      </div>

      <div class="flex-right">
        <Image
          src={pershing4}
          alt="pershing46"
          format="avif"
          loading="lazy"
          class="flex-img hidden-fade"
        />
      </div>
    </div>

    <!-- specs -->
    <div class="section txtOnDark center txt-center flex-columns">
      <div class="center">
        <h2 class="h2">Specifications</h2>
        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          YEAR: <span class="clr-main-light">2007</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>

        <p class="clr-prim-acc body-large normal-weight">
          CREW: <span class="clr-main-light">Captain (sailor if needed)</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          CABINS: <span class="clr-main-light">3</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          LENGTH: <span class="clr-main-light">15m</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          BERTHS: <span class="clr-main-light">4 + 2</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          BEAM: <span class="clr-main-light">4,2m</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          TOILETS: <span class="clr-main-light">3</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          WATER TANK: <span class="clr-main-light">350l</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          FUEL TANK: <span class="clr-main-light">2000l</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          FUEL CONSUMPTION: <span class="clr-main-light">150l/h</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          CRUISING SPEED: <span class="clr-main-light">24 knots</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          ENGINE BUILDER: <span class="clr-main-light">MAN</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          LAYOUT: <span class="clr-main-light"
            >1 master cabin with double bed, <br />1 VIP cabin with queen size,
            1 guest cabin with two single beds</span
          >
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          MAX. PASSENGERS: <span class="clr-main-light"
            >10 for daily charter and transfer and 6 for overnight stay</span
          >
        </p>
      </div>
    </div>

    <!-- accomodation -->
    <div class="section txtOnDark center txt-center flex-columns-reverse">
      <div class="flex-left">
        <Image
          src={pershing12}
          alt="pershing46"
          format="avif"
          loading="lazy"
          class="flex-img hidden-fade"
        />
      </div>

      <div class="flex-right boat-text-r">
        <h2 class="h2">Accomodation</h2>
        <div class="line-acc-full mart-200"></div>
        <p class="body padt-200 padb-200">
          Pershing 46 is a wonderful boat that can accomodate up to 6 people for
          an overnight stay. There is one master cabin with a double bed, one
          VIP cabin with a queen size bed and 1 guest cabin with two single
          beds. On the boat there are three toilets.
        </p>
      </div>
    </div>

    <!-- terms of payment -->
    <div class="section txtOnDark center txt-center flex-columns">
      <div class="flex-left boat-text-l">
        <h2 class="h2 left">Terms of payment</h2>
        <div class="line-acc-full mart-200"></div>
        <p class="body padt-200 padb-200">
          The payment is done via bank transfer. 50% deposit is required as your
          confirmation for the booking. Other 50% should be paid one month upon
          the start of the charter or seven days before if it is a daily trip or
          a transfer.
        </p>
        <p class="h4 clr-prim-acc">All boats include:</p>
        <ul class="boats-include body padt-200 padb-200 left">
          <li>Complimentary towels</li>
          <li>Snorkels</li>
          <li>VAT (25% Croatian tax)</li>
          <li>
            Complimentary drinks (water, soft drinks, beer, few bottles of wine,
            coffee)
          </li>
          <li>Snacks (crisps, nuts, fruit, olives, etc.)</li>
          <li>Extra toys (depending on boat - contact us for more details)</li>
          <li>Crew including captain and deckhand/hostess</li>
        </ul>
      </div>

      <div class="flex-right">
        <Image
          src={pershing10}
          alt="pershing46"
          format="avif"
          loading="lazy"
          class="flex-img hidden-fade"
        />
      </div>
    </div>

    <!-- GALLERY -->

    <GalleryPershing />
  </div>
  <script>
    import "../../scripts/gallery.js";
    import "../../scripts/interval.js";
  </script>
</MainLayout>
