---
import MainLayout from "../../layouts/MainLayout.astro";

import GalleryAtlantis from "../../components/GalleryAtlantis.astro";

//image compression
import { Image } from "astro:assets";
import atlantis1 from "../../images/galleries/atlantis/img1.jpg";
import atlantis2 from "../../images/galleries/atlantis/img2.jpg";
import atlantis3 from "../../images/galleries/atlantis/img3.jpg";
import atlantis4 from "../../images/galleries/atlantis/img4.jpg";
import atlantis5 from "../../images/galleries/atlantis/img5.jpg";
import atlantis6 from "../../images/galleries/atlantis/img6.jpg";
import atlantis7 from "../../images/galleries/atlantis/img7.jpg";
import atlantis8 from "../../images/galleries/atlantis/img8.jpg";
import atlantis9 from "../../images/galleries/atlantis/img9.jpg";
import atlantis10 from "../../images/galleries/atlantis/img10.jpg";
import atlantis11 from "../../images/galleries/atlantis/img11.jpg";
import atlantis12 from "../../images/galleries/atlantis/img12.jpeg";

//icons
import { Icon } from "astro-icon";

const {
  title,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang="en"
  pageIndex="boat-fleet"
  pageIndexEn="boat-fleet"
  title="Atlantis 50 | Elamio Yachting"
  charset={charset}
  description="Check out our Atlantis 50 boat and details | Elamio Yachting"
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
  noindex
  nofollow
>
  <div class="section wrapper txtOnDark mart-900 center">
    <h1 class="h1 txt-center padt-200 padb-100">Atlantis 50</h1>
    <h2 class="txt-label txt-center padb-900">Blue Marina</h2>
    <div class="flex-rows">
      <div class="full">
        <Image
          src={atlantis4}
          alt="atlantis 50 elamio"
          format="avif"
          loading="lazy"
          class="boat-img hidden-fade"
        />
      </div>
      <div class="flex-center boat-specs">
        <p class="h5">
          Engines: <span class="clr-prim-acc body-large normal-weight"
            >2 VOLVO PENTA 775hp</span
          >
        </p>
        <p class="h5">
          Top Speed: <span class="clr-prim-acc body-large normal-weight"
            >32 KNOTS</span
          >
        </p>
        <p class="h5">
          Consumption: <span class="clr-prim-acc body-large normal-weight"
            >160L @ 22kts</span
          >
        </p>
      </div>
    </div>

    <!-- about -->
    <div class="section txtOnDark center txt-center flex-columns">
      <div class="flex-left boat-text-l">
        <h2 class="h2">About</h2>
        <div class="line-acc-full mart-200"></div>
        <p class="body padt-200 padb-200">
          Welcome to Atlantis 50. 'Blue Marina' is a splendid boat that offers a
          true Italian design and is a great choice for relaxing on the
          iridescent waters of Adriatic and swimming in crystal clear sea. Toast
          the occasion with a crisp glass of bubbles and enjoy the
          Medditerranean lifestyle in all its glory!
        </p>
        <a href="/media/EY-Atlantis50-brochure.pdf" target="_blank"
          ><div class="btnFill marb-200">BROCHURE</div></a
        >
      </div>

      <div class="flex-right">
        <Image
          src={atlantis2}
          alt="atlantis46"
          format="avif"
          loading="lazy"
          class="flex-img hidden-fade"
        />
      </div>
    </div>

    <!-- charter -->
    <div class="section txtOnDark center txt-center flex-columns-reverse">
      <div class="flex-left">
        <Image
          src={atlantis3}
          alt="atlantis46"
          format="avif"
          loading="lazy"
          class="flex-img hidden-fade"
        />
      </div>

      <div class="flex-right boat-text-r">
        <h2 class="h2">Charter</h2>
        <div class="line-acc-full mart-200"></div>
        <p class="body padt-200 padb-200">
          With Master double bed cabin with en-suite, Guest double cabin and
          Twin bed cabin and another bathroom, the boat offers abundance of
          space and comfort for four people. If spending nights in marinas and
          little towns, the crew can be sleeping on the shore, making room to
          accommodate another two people. The crew will be leaving the boat in
          the evening, giving guests’ privacy and returning in the morning with
          fresh bagels and preparing them breakfast.
        </p>
      </div>
    </div>

    <!-- DAILY TRIPS AND TRANSFERS -->
    <div class="section txtOnDark center txt-center flex-columns">
      <div class="flex-left boat-text-l">
        <h2 class="h2 left">Daily trips and transfers</h2>
        <div class="line-acc-full mart-200"></div>
        <p class="body padt-200 padb-200">
          With large sun beds both in front and back, large seating area in
          cockpit and nice outdoor kitchenette this boat has everything needed
          for a perfect day at sea. Accommodating up to 12 people makes it
          suitable for slightly larger groups that are ready to soak up the
          Croatian sun and live their best life! Our crew is going to do their
          best to make your day at sea memorable!
        </p>
      </div>

      <div class="flex-right">
        <Image
          src={atlantis4}
          alt="atlantis46"
          format="avif"
          loading="lazy"
          class="flex-img hidden-fade"
        />
      </div>
    </div>

    <!-- specs -->
    <div class="section txtOnDark center txt-center flex-columns">
      <div class="center">
        <h2 class="h2">Specifications</h2>
        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          YEAR: <span class="clr-main-light">2007</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>

        <p class="clr-prim-acc body-large normal-weight">
          CREW: <span class="clr-main-light">2 (skipper and deckhand)</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          CABINS: <span class="clr-main-light">3</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          LENGTH: <span class="clr-main-light">15m</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          BERTHS: <span class="clr-main-light">6</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          BEAM: <span class="clr-main-light">4,2m</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          TOILETS: <span class="clr-main-light">2</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          WATER TANK: <span class="clr-main-light">500l</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          FUEL TANK: <span class="clr-main-light">1800l</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          FUEL CONSUMPTION: <span class="clr-main-light">160l/h</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          CRUISING SPEED: <span class="clr-main-light">23 knots</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          ENGINE: <span class="clr-main-light">2x Volvo Penta 775</span>
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          LAYOUT: <span class="clr-main-light"
            >1 master cabin with king size bed with private bathroom that has a
            shower, <br />1 double cabin and 1 twin cabin. <br />All cabins have
            wardrobe, windows, Tv and radio. There is another toilet with a
            shower.</span
          >
        </p>

        <div class="line-acc-full mart-200 marb-200"></div>
        <p class="clr-prim-acc body-large normal-weight">
          MAX. PASSENGERS: <span class="clr-main-light"
            >12 for daily charter and transfer and 6 for overnight stay</span
          >
        </p>
      </div>
    </div>

    <!-- accomodation -->
    <div class="section txtOnDark center txt-center flex-columns-reverse">
      <div class="flex-left">
        <Image
          src={atlantis12}
          alt="atlantis46"
          format="avif"
          loading="lazy"
          class="flex-img hidden-fade"
        />
      </div>

      <div class="flex-right boat-text-r">
        <h2 class="h2">Accomodation</h2>
        <div class="line-acc-full mart-200"></div>
        <p class="body padt-200 padb-200">
          Atlantis 50 has a beautiful master cabin with a kingsize bed that also
          has a private bathroom with a shower. There is also a double cabin and
          a twin cabin. All cabins have a wardrobes and windows and are equiped
          with a television and a radio. There is also one more toilet with a
          shower on the boat.
        </p>
      </div>
    </div>

    <!-- terms of payment -->
    <div class="section txtOnDark center txt-center flex-columns">
      <div class="flex-left boat-text-l">
        <h2 class="h2 left">Terms of payment</h2>
        <div class="line-acc-full mart-200"></div>
        <p class="body padt-200 padb-200">
          The payment is done via bank transfer. 50% deposit is required as your
          confirmation for the booking. Other 50% should be paid one month upon
          the start of the charter or seven days before if it is a daily trip or
          a transfer.
        </p>
        <p class="h4 clr-prim-acc">All boats include:</p>
        <ul class="boats-include body padt-200 padb-200 left">
          <li>Complimentary towels</li>
          <li>Snorkels</li>
          <li>VAT (25% Croatian tax)</li>
          <li>
            Complimentary drinks (water, soft drinks, beer, few bottles of wine,
            coffee)
          </li>
          <li>Snacks (crisps, nuts, fruit, olives, etc.)</li>
          <li>Extra toys (depending on boat - contact us for more details)</li>
          <li>Crew including captain and deckhand/hostess</li>
        </ul>
      </div>

      <div class="flex-right">
        <Image
          src={atlantis10}
          alt="atlantis46"
          format="avif"
          loading="lazy"
          class="flex-img hidden-fade"
        />
      </div>
    </div>

    <!-- GALLERY -->

    <GalleryAtlantis />
  </div>
  <script>
    import "../../scripts/gallery.js";
  </script>
</MainLayout>
