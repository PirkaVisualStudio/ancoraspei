---
import MainLayout from "../layouts/MainLayoutEN.astro";

//image compression
import { Image } from "astro:assets";

//import main site data
import siteInfo from "../data/siteInfo.json";

//import icons
import { Icon } from "astro-icon/components";

//import images
import vila from "../images/hero/vilaLQ.jpg";
import kuzina from "../images/hero/kuzina.jpg";
import ulica from "../images/hero/ulica.jpg";
import svi from "../images/hero/svi.jpg";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="about/"
  pageIndexHr="about/"
  title={"About us" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Get to know us, what we do and how did we end up here" +
    siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="hero-standard bg-prim-acc clr-main-light">
    <div class="container wrapper center">
      <h1 class="txt-label marb-400">ABOUT US</h1>
      <h2 class="h3 padb-900">
        Find out more about us. Our mission, values and all the things that
        matter to us.
      </h2>
    </div>
  </section>

  <section class="">
    <div class="container wrapper-full center">
      <div class="flex-column">
        <div class="flex-left section wrapper">
          <h2 class="txt-label marb-400">LET ME PASS</h2>
          <h3 class="body-large padb-900">
            In a city where streets are narrow and flavours are wide, a place
            was born that doesn’t call you in, it lets you through. It’s the
            name of a real street inside Diocletian’s Pal- ace, so narrow that
            two people can’t pass each other. Someone always has to stop and
            say: Pusti me proć. <br /><br />
            That everyday moment became the name of the street. And later, our identity.
          </h3>
        </div>
        <div class="flex-right">
          <Image
            src={ulica}
            alt="pusti me proc"
            loading="eager"
            class="img-full"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="">
    <div class="container wrapper-full center">
      <div class="flex-column-reverse">
        <div class="flex-left">
          <Image
            src={svi}
            alt="pusti me proc"
            loading="eager"
            class="img-full"
          />
        </div>
        <div class="flex-right section wrapper">
          <h2 class="txt-label marb-400">FRIENDLY AND WELCOMING</h2>
          <h3 class="body-large padb-900">
            This is not a seasonal concept. This is a place rooted in the
            everyday life of Split. Open even in winter, lived by locals, but
            also understandable to tourists.
          </h3>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
