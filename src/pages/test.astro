---
import MainLayout from "../layouts/MainLayout.astro";
//slider

import ReviewsSlider from "../components/Slider.astro";

//image compression
import { Image } from "astro:assets";

import hero from "../images/hero/hero.jpg";

//icons
import { Icon } from "astro-icon";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="test"
  pageIndexEn="testEn"
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="section flex-center txtOnLight padt-900 mart-900">
    <div class="hero-container section">
      <h1 class="h1 section">Ovo je TEST PAGE</h1>
      <h2 class="h5">Ovo je H5</h2>
      <a href="/">NATRAG</a>
    </div>
  </section>

  <!-- Slider script -->
  <script>
    import "../scripts/slider.js";
  </script>
</MainLayout>
