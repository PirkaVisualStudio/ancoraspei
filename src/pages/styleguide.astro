---
//Main Layout
import MainLayout from "../layouts/MainLayoutHR.astro";

//import sliders

import ReviewsSlider from "../components/Slider.astro";

//import gallery

//import main site data
import siteInfo from "../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images
import hero from "../images/hero/hero.jpg";

//import icons
import { Icon } from "astro-icon";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang="hr"
  pageIndex="styleguide"
  pageIndexEn="styleguide"
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="section-nav wrapper">
    <h1 class="h1">This is H1</h1>
    <h2 class="h2">This is H2</h2>
    <h2 class="h3">This is H3</h2>
    <h2 class="h4">This is H4</h2>
    <h2 class="h5">This is H5</h2>
    <h2 class="h6">This is H6</h2>
    <p class="body">This is body</p>
    <p class="body-bold">This is body bold</p>
    <p class="body-large">This is body large</p>
    <p class="body-large-bold">This is body large bold</p>
    <p class="txtLabel">This is label</p>
    <p class="txtLabel upper">This is label uppercase</p>
    <Image
      src={hero}
      alt="alt"
      format="avif"
      loading="lazy"
      class=""
      style="object-fit:cover; width:300px; height:300px"
    />
  </section>

  <!-- Slider script -->
  <script>
    import "../scripts/slider.js";
    import "../scripts/accordion.js";
  </script>
</MainLayout>
