---
import MainLayout from "../layouts/MainLayoutEN.astro";

//image compression
import { Image } from "astro:assets";

//import main site data
import siteInfo from "../data/siteInfo.json";

//import icons
import { Icon } from "astro-icon/components";

//import images
import vila from "../images/hero/vila.jpg";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="services/"
  pageIndexHr="usluge/"
  title={"Our services" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"A broader view of our services" +
    siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="center hero-home">
    <Image src={vila} alt="maven mib" loading="eager" class="hero_image" />
    <div class="container wrapper">
      <p class="h1 marb-400 clr-main-light">SERVICES</p>
    </div>
  </section>
</MainLayout>

<!-- Google Captcha -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
