---
import MainLayout from "../layouts/MainLayoutEN.astro";

//image compression
import { Image } from "astro:assets";

//import main site data
import siteInfo from "../data/siteInfo.json";

//import icons
import { Icon } from "astro-icon/components";

//import images
import vila from "../images/hero/vilaLQ.jpg";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="services/"
  pageIndexHr="usluge/"
  title={"Our services" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"A broader view of our services" +
    siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="hero-standard bg-prim-acc clr-main-light">
    <div class="container wrapper center">
      <h1 class="txt-label marb-400">SERVICES</h1>
      <h2 class="h3 padb-900">
        a complete list of our services. Contact us for more advice and detailed
        insights
      </h2>
    </div>
  </section>

  <section class="services-index">
    <div class="container wrapper center">
      <h2 class="h4">Surveying</h2>
      <ul>
        <li><a href="#geodeticServices">Geodetic services</a></li>
        <li><a href="#projectmanagement">Project management</a></li>
        <li><a href="#">Legal services</a></li>
      </ul>
      <h2 class="h4">Project management</h2>
      <ul>
        <li><a href="#">Geodetic surveying</a></li>
        <li><a href="#">Project management</a></li>
        <li><a href="#">Legal services</a></li>
      </ul>
    </div>
  </section>

  <section class="section services-content">
    <div class="container wrapper center">
      <h3 class="h3">Surveying</h3>
      <div class="line-acc-full marb-600"></div>
      <div class="flex-column">
        <div class="flex-left">
          <p class="body-large-bold title" id="geodeticServices">
            Geodetic services
          </p>
          <p class="description">
            Lorem, ipsum dolor sit amet consectetur adipisicing elit. Eligendi
            temporibus provident libero nemo placeat fugit est! Vitae, doloribus
            architecto iste, culpa dolores, dolorum placeat velit in fugiat
            dolore pariatur sint!
          </p>
        </div>
        <div class="flex-right">
          <Image src={vila} alt="maven mib" loading="eager" class="img-full" />
        </div>
      </div>

      <div class="flex-column">
        <div class="flex-left">
          <p class="body-large-bold title" id="projectmanagement">
            Project management
          </p>
          <p class="description">
            Lorem, ipsum dolor sit amet consectetur adipisicing elit. Eligendi
            temporibus provident libero nemo placeat fugit est! Vitae, doloribus
            architecto iste, culpa dolores, dolorum placeat velit in fugiat
            dolore pariatur sint!
          </p>
        </div>
        <div class="flex-right">
          <Image src={vila} alt="maven mib" loading="eager" class="img-full" />
        </div>
      </div>
    </div>
  </section>
</MainLayout>
