---
import MainLayout from "../layouts/MainLayoutHR.astro";

//image compression
import { Image } from "astro:assets";

//import main site data
import siteInfo from "../data/siteInfo.json";

//import icons
import { Icon } from "astro-icon/components";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="kontakt"
  pageIndexEn="contact"
  title={"Kontakt" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Javite nam se sa upitom" + siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
  noindex
  nofollow
>
  <div>
    <div class="wrapper center">
      <div class="section">
        <h1 class="h1 padt-900 mart-900">Kontakt</h1>
        <h3 class="body-bold body-large padb-400">
          Pošaljite nam upit u vezi usluge koja vas zanima
        </h3>
        <p class="body padb-900">
          Potrudit ćemo se odgovoriti u što kraćem roku.
        </p>
        <hr class="marb-900" />
      </div>
    </div>
  </div>
</MainLayout>

<!-- Google Captcha -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
