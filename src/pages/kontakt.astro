---
import MainLayout from "../layouts/MainLayoutHR.astro";

//image compression
import { Image } from "astro:assets";

//import main site data
import siteInfo from "../data/siteInfo.json";

//import icons
import { Icon } from "astro-icon/components";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="kontakt"
  pageIndexEn="contact"
  title={"Kontakt" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Javite nam se sa upitom" + siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
  noindex
  nofollow
>
  <div>
    <div class="wrapper center">
      <div class="section">
        <h1 class="h1 padt-900 mart-900">Kontakt</h1>
        <h3 class="body-bold body-large padb-400">
          Pošaljite nam upit u vezi usluge koja vas zanima
        </h3>
        <p class="body padb-900">
          Potrudit ćemo se odgovoriti u što kraćem roku.
        </p>
        <hr class="marb-900" />

        <form
          name="contact"
          id="formContact"
          class="contact-form"
          method="POST"
          data-netlify="true"
          action="/hvala/"
          data-netlify-recaptcha="true"
        >
          <label class="body-bold" for="name">Ime:</label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder="Ime i prezime"
            required
          />
          <label class="body-bold" for="email">E-mail:</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="info@mail.hr"
            required
          />
          <label class="body-bold" for="message">Poruka:</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="Zanima me..."
            required></textarea>

          <label class="body mart-900 marb-900 txt-center">
            Molimo potvrdite da niste robot zbog sprječavanja spam pošte:
          </label>

          <button type="submit" class="btn-form mart-900">POŠALJI</button>
        </form>
      </div>
    </div>
  </div>
</MainLayout>

<!-- Google Captcha -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
