---
import MainLayout from "../layouts/MainLayoutHR.astro";

//image compression
import { Image } from "astro:assets";

//import main site data
import siteInfo from "../data/siteInfo.json";

//import icons
import { Icon } from "astro-icon/components";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="contact/"
  pageIndexHr="kontakt/"
  title={"Kontakt" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Javite nam se" + siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <div>
    <div class="wrapper center">
      <div class="section">
        <h1 class="h1 padt-900 mart-900 padb-400">Kontakt</h1>
        <h2 class="body-bold body-large padb-200">
          Pošaljite nam upit uz pomoć forme ili koristite kontakt INFORMACIJE.
        </h2>
        <p class="body padb-900">
          Potrudit ćemo se odgovoriti u što kraćem roku
        </p>
        <p class="body-bold padb-100">KONTAKT INFORMACIJE</p>
        <p class="padb-100">
          mail: <a href="mailto:pustimeproc.st@gmail.com"
            >pustimeproc.st@gmail.com</a
          >
        </p>
        <p class="padb-400">
          telefon: <a href="tel:0038521675015">+385 21 675 015</a>
        </p>
        <hr class="marb-900" />
      </div>
    </div>
    <form
      name="kontakt-forma"
      id="formContact"
      class="contact-form"
      method="POST"
      data-netlify="true"
      action="/hvala/"
      data-netlify-recaptcha="true"
    >
      <label class="body-bold" for="name">Ime:</label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder="Ivan Ivić"
        required
      />
      <label class="body-bold" for="email">E-mail:</label>
      <input
        type="email"
        id="email"
        name="email"
        placeholder="info@mail.hr"
        required
      />
      <label class="body-bold" for="message">Poruka:</label>
      <textarea
        id="message"
        name="message"
        rows="4"
        placeholder="Zanima me..."
        required></textarea>

      <label class="body
        mart-900
        marb-900
        txt-center">
        Molimo potvrdite da niste robot:
      </label>
      <div class="g-recaptcha" data-sitekey=""></div>
      <button type="submit" class="btn-form mart-900">POŠALJI</button>
    </form>
  </div>
</MainLayout>

<!-- Google Captcha -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
