---
import MainLayout from "../layouts/MainLayoutHR.astro";

//image compression
import { Image } from "astro:assets";

import hero from "../images/hero/hero.jpg";

//import main site data
import siteInfo from "../data/siteInfo.json";

//icons
import { Icon } from "astro-icon";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="kontakt"
  pageIndexEn="contact"
  title={"Kontakt" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Javite nam se sa upitom" + siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
  noindex
  nofollow
>
  <div class="hero_content txtOnDark txt-center flex-center">
    <div class="black"></div>
    <Image
      src={hero}
      alt="boat"
      format="avif"
      loading="lazy"
      class="hero-img"
    />
    <div class="heroContainer-default">
      <h1 class="h1">Contact page</h1>

      <h2 class="body">
        You can make a reservation request here or just send us an inquiry.
      </h2>
    </div>
  </div>

  <div class="txtOnDark">
    <div class="container wrapper-medium center">
      <div class="section">
        <h2 class="h1 padb-100">Contact us</h2>
        <h3 class="body-bold body-large padb-400">
          Book your trip or send us an inquiry
        </h3>
        <p class="body padb-900">
          We will do our best to reply as soon as possible.
        </p>
        <hr class="marb-900" />

        <form
          name="contact"
          class="contact-form"
          method="post"
          action="../test.php"
        >
          <label class="body-bold" for="name">Name:</label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder="John Doe"
            required
          />
          <label class="body-bold" for="email">E-mail:</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="info@mail.hr"
            required
          />
          <label class="body-bold" for="message">Message:</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="I want to book a boat for..."
            required></textarea>

          <label class="body mart-900 marb-900">
            Please confirm that your'e not a robot so we can prevent spam mail:
          </label>

          <div class="g-recaptcha" data-sitekey="your_site_key"></div>

          <button type="submit" class="btn-form mart-900">SEND</button>
        </form>
      </div>
    </div>
  </div>
</MainLayout>
