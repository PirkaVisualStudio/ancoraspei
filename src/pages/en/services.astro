---
import MainLayout from "../../layouts/MainLayoutEN.astro";

//image compression
import { Image } from "astro:assets";

//import main site data
import siteInfo from "../../data/siteInfo.json";

//import icons
import { Icon } from "astro-icon/components";

//import images
import vila from "../../images/hero/vilaLQ.jpg";
import kuzina from "../../images/hero/kuzina.jpg";
import ulica from "../../images/hero/hero.jpg";
import svi from "../../images/hero/hero.jpg";
import boat from "../../images/hero/ancora_boat.jpg";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="services/"
  pageIndexHr="usluge/"
  title={"Services" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"List of services" + siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="hero-standard services bg-prim-acc clr-main-light">
    <div class="container center wrapper">
      <div class="txt-left">
        <h1 class="txt-label marb-400">SERVICES</h1>
        <h2 class="h3 padb-900 txt-left">What can you learn from us?</h2>
      </div>
    </div>
  </section>

  <section class="">
    <div class="container wrapper center">
      <div class="flex-column">
        <div class="flex-left section wrapper">
          <h2 class="txt-label marb-100">WHAT DO WE OFFER?</h2>
          <h3 class="h5 padb-400">
            Practical training at sea for safe and independent boat handling
          </h3>
          <p class="body padb-900">
            Our services are related to practical training in boat maneuvering
            as well as learning other skills necessary for safe and independent
            navigation at sea. Ancora Spei does not issue any licenses or
            permits for boat captain training, but only offers the service of
            concrete practice at sea. <br /><br /> This site is still under construction,
            so for all information, please contact us via the information available
            on this website or our social networks.
          </p>
          <a href="/en/contact/"><div class="btn-fill">CONTACT</div></a>
        </div>
        <div class="flex-right">
          <Image
            src={boat}
            alt="ancora spei na brodu"
            loading="eager"
            class="img-full"
          />
        </div>
      </div>
    </div>
  </section>
</MainLayout>
