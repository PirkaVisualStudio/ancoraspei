---
//Main Layout
import MainLayout from "../../layouts/MainLayoutEN.astro";

//import main site data
import siteInfo from "../../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images
import logo from "../../images/logos/pirka_logo_light.svg";
import peskarija from "../../images/hero/peskarija.jpg";
import billboard from "../../images/hero/billboard.jpg";

import tecada from "../../videos/tecada.mp4";

//import icons
import { Icon } from "astro-icon/components";

//import components
import VideoSlider from "../../components/elements/VideoSlider.astro";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexEn=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="center hero-home bg-dark">
    <Image
      src={peskarija}
      alt="pirka visual studio peskarija split"
      loading="eager"
      class="hero_image"
    />
    <div class="container wrapper center">
      <Image
        src={logo}
        alt="pirka visual design logotip"
        loading="eager"
        id="heroLogo"
        class="padb-900"
      />
      <p class="body-bold clr-main-light marb-900">
        Next Level Video Production & photography.
      </p>
      <a href="https://portal.pirka.hr" target="_blank"
        ><div class="btn-fill">LOG IN</div></a
      >
    </div>
  </section>

  <!-- VIDEO SLIDERS-->
  <section class="videos bg-dark section">
    <div class="wrapper-medium center txt-center">
      <h1 class="h3 clr-prim-acc padb-400">
        Professional videoproduction & photography
      </h1>
      <p class="body-large clr-prim-acc">
        We offer services of videoproduction and photography and aerial footage
        for your brand, product, real estate or events.
      </p>
    </div>
    <div class="container"><VideoSlider /></div>
  </section>

  <!-- video -->
  <section class="center bg-dark">
    <div class="wrapper-medium center txt-center section">
      <p class="txt-label padb-400">CONTACT US</p>
      <h2 class="h3 clr-prim-acc padb-400">Need video? Or a photo?</h2>
      <p class="body-large clr-prim-acc padb-900">
        Get in touch with us and let your project into our hands.
      </p>
      <a href="/en/contact/"><div class="btn-fill">CONTACT</div></a>
    </div>
    <div class="container center">
      <video
        loop
        autoplay
        muted
        playsinline
        webkit-playsinline
        class="video_full"
      >
        <source src={tecada} type="video/mp4" />
      </video>
    </div>
  </section>
  <!-- video
  <Image
    src={peskarija}
    alt="pirka visual design logotip"
    loading="eager"
    class="img-full"
  />-->
</MainLayout>

<script>
  import "../../scripts/slider.js";
</script>
