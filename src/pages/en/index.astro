---
import MainLayout from "../../layouts/MainLayout.astro";

//image compression
import { Image } from "astro:assets";

//icons
import { Icon } from "astro-icon";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang="en"
  pageIndex=""
  pageIndexEn=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="section flex-center txtOnLight padt-900 mart-900">
    <div class="hero-container section">
      <h1 class="h1 section">This is H1</h1>
      <h2 class="h5">This is H5</h2>
      <a href="/">HR</a>
      <a href="/en/test/">TEST PAGE</a>
      <a href="/en/thanks/">THANKS</a>
    </div>
  </section>
</MainLayout>
