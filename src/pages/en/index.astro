---
//Main Layout
import MainLayout from "../../layouts/MainLayoutEN.astro";

//import main site data
import siteInfo from "../../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images

import logo from "../../images/logos/ancora_logo_full_prim.svg";
import hero from "../../images/hero/hero.jpg";
import boat from "../../images/hero/ancora_boat.jpg";
import pajet from "../../images/hero/pajet.jpg";
import tece from "../../images/hero/tece.jpg";
import kuzina from "../../images/hero/kuzina.jpg";

//import icons
import { Icon } from "astro-icon/components";

//import components
import ReviewsSlider from "../../components/elements/TestimonialsHR.astro";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexHr=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="center hero-home">
    <div class="hero-mask">
      <Image
        src={hero}
        alt="ancora spei splitska vrata"
        loading="eager"
        class="hero_image"
      />
    </div>
    <div class="container wrapper txt-center">
      <Image src={logo} alt="ancora spei logo" loading="eager" id="heroLogo" />
      <h1 class="h5 padb-900">
        Practical education at sea for safe and independent boat handling
      </h1>
      <div class="hero-cta-btn">
        <a href="/kontakt/"><div class="btn-fill">KONTAKT</div> </a>
      </div>
    </div>

    <!-- services -->

    <section class="section center wrapper txt-center bg-light clr-ter-acc">
      <p class="txt-label padb-400">SAIL WITHOUT STRESS</p>
      <h2 class="h3 padb-100">Steer the boat independently</h2>
      <p class="body-large padb-900">
        We offer practical training at sea, whether you are a boat owner or not.
        We provide everything you need to be able to sail a boat safely and
        competently at the end of the course.
      </p>
      <a href="/services/"><div class="btn-fill">SERVICES</div></a>
    </section>

    <!-- testimonials -->

    <!-- img -->
    <section class="hidden-fade section">
      <Image src={hero} alt="ancora spei" loading="eager" class="img-full2" />
    </section>

    <!-- cta 1-->
    <section class="center bg-light clr-ter-acc">
      <div class="wrapper-medium center txt-center section-2">
        <p class="txt-label padb-400 hidden-fade delay1">EXPERIENCE AT SEA</p>
        <h2 class="h3 padb-400 hidden-fade delay2">
          Professional instructors with many years of experience
        </h2>
        <p class="body-large padb-900 hidden-fade delay3">
          Ancora Spei offers an individual approach to each client and their
          needs. Our goal is to transfer knowledge but also to share real
          experience and love for the sea. Our instructors have many years of
          maritime experience in operating a boat in all weather conditions on
          the Adriatic Sea.
        </p>
        <a href="/contact/"><div class="btn-fill">CONTACT</div></a>
      </div>
    </section>

    <!-- img -->
    <section class="hidden-fade section">
      <Image src={hero} alt="ancora spei" loading="eager" class="img-full2" />
    </section>

    <!-- cta 2-->
    <section class="center section bg-light clr-ter-acc">
      <div class="wrapper-medium center txt-center section-2">
        <p class="txt-label padb-400 hidden-fade delay1">
          KNOWLEDGE ACQUIRED AT SEA
        </p>
        <h2 class="h3 padb-400 hidden-fade delay2">
          Master skills that can't be learned from a book
        </h2>
        <p class="body-large padb-900 hidden-fade delay3">
          Learning is incomplete without real practice. Sail with us and turn
          theoretical knowledge into practical skills that will give you safety,
          confidence and readiness for independent sailing.
        </p>
        <a href="/services/"><div class="btn-fill">SERVICES</div></a>
      </div>
    </section>
  </section>
</MainLayout>

<script>
  import "../../scripts/slider.js";
</script>
