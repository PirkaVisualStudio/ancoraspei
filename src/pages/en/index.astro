---
//Main Layout
import MainLayout from "../../layouts/MainLayoutEN.astro";

//import main site data
import siteInfo from "../../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images

import logo from "../../images/logos/ancora_logo_full_prim.svg";
import hero from "../../images/hero/hero.jpg";
import tece from "../../images/hero/tece.jpg";
import kuzina from "../../images/hero/kuzina.jpg";

//import icons
import { Icon } from "astro-icon/components";

//import components
import ReviewsSlider from "../../components/elements/TestimonialsHR.astro";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexHr=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="center hero-home">
    <div class="hero-mask">
      <Image
        src={hero}
        alt="ancora spei splitska vrata"
        loading="eager"
        class="hero_image"
      />
    </div>
    <div class="container wrapper txt-center">
      <Image src={logo} alt="ancora spei logo" loading="eager" id="heroLogo" />
      <h1 class="h5 padb-900">
        Practical education at sea for safe boat operation
      </h1>
      <div class="hero-cta-btn">
        <a href="/services/" target="_blank"
          ><div class="btn-fill">SERVICES</div>
          <a href="/services/"><div class="btn-fill">PRICING</div></a>
        </a>
      </div>
    </div>

    <!-- services -->

    <section class="section center wrapper txt-center bg-light clr-ter-acc">
      <p class="txt-label padb-400">AJ PRISTANI VIŠE</p>
      <h2 class="h3 padb-100">Boating instructions</h2>
      <p class="body-large padb-900">
        Learn to sail a boat and be safe in navigation and sailing the Adriatic
      </p>
      <a href="/services/"><div class="btn-fill">RESERVATION</div></a>
    </section>

    <!-- testimonials -->

    <ReviewsSlider />

    <!-- img -->
    <section class="hidden-fade section">
      <Image src={hero} alt="ancora spei" loading="eager" class="img-full2" />
    </section>

    <!-- cta 1-->
    <section class="center bg-light clr-ter-acc">
      <div class="wrapper-medium center txt-center section-2">
        <p class="txt-label padb-400 hidden-fade delay1">BE SAFE AT SEA</p>
        <h2 class="h3 padb-400 hidden-fade delay2">Boating lessons</h2>
        <p class="body-large padb-900 hidden-fade delay3">
          At Ancora Spei, expect a top-notch boating learning experience. Our
          instructors have years of maritime experience operating boats in all
          weather conditions on the Adriatic Sea.
        </p>
        <a href="/contact/"><div class="btn-fill">CONTACT</div></a>
      </div>
    </section>

    <!-- img -->
    <section class="hidden-fade section">
      <Image src={hero} alt="ancora spei" loading="eager" class="img-full2" />
    </section>

    <!-- cta 2-->
    <section class="center section bg-light clr-ter-acc">
      <div class="wrapper-medium center txt-center section-2">
        <p class="txt-label padb-400 hidden-fade delay1">ROPES</p>
        <h2 class="h3 padb-400 hidden-fade delay2">Learn the right knot</h2>
        <p class="body-large padb-900 hidden-fade delay3">
          In addition to experience at sea, we also offer the indispensable
          knowledge that every sailor must have in order to sail safely.
        </p>
        <a href="/services/"><div class="btn-fill">SERVICES</div></a>
      </div>
    </section>
  </section>
</MainLayout>

<script>
  import "../../scripts/slider.js";
</script>
