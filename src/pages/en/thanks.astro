---
import MainLayout from "../../layouts/MainLayoutHR.astro";

//image compression
import { Image } from "astro:assets";

//icons
import { Icon } from "astro-icon";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang="en"
  pageIndex="hvala"
  pageIndexEn="thanks"
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="section flex-center txtOnLight padt-900 mart-900">
    <div class="hero-container section">
      <h1 class="h1 section">THANK YOU</h1>
      <h2 class="h5">This is H5</h2>
      <a href="/en/">BACK</a>
    </div>
  </section>

  <!-- Slider script -->
  <script>
    import "../../scripts/slider.js";
  </script>
</MainLayout>
