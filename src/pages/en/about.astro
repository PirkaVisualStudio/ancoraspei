---
import MainLayout from "../../layouts/MainLayoutEN.astro";

//image compression
import { Image } from "astro:assets";

//import main site data
import siteInfo from "../../data/siteInfo.json";

//import icons
import { Icon } from "astro-icon/components";

//import images
import vila from "../images/hero/vilaLQ.jpg";
import kuzina from "../images/hero/kuzina.jpg";
import ulica from "../../images/hero/ulica.jpg";
import svi from "../../images/hero/svi.jpg";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="about/"
  pageIndexHr="about/"
  title={"About us" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Get to know us, what we do and how did we end up here" +
    siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="hero-standard bg-prim-acc clr-main-light">
    <div class="container wrapper center">
      <h1 class="txt-label marb-400">O NAMA</h1>
      <h2 class="h3 padb-900">
        Saznaj malo više o nama, našoj misiji, vrijednostima i ostalim stvarima
        koje su nam važne.
      </h2>
    </div>
  </section>

  <section class="">
    <div class="container wrapper center">
      <div class="flex-column">
        <div class="flex-left section wrapper">
          <h2 class="txt-label marb-400">PUSTI ME PROĆ</h2>
          <h3 class="body-large padb-900">
            U gradu u kojem su ulice uske, a okusi široki, nastalo je misto koje
            ne zove, nego pušta. Pusti me proć naziv je stvarne ulice unutar
            Dioklecijanove palače, toliko uske da se dvoje ljudi ne mogu
            mimoići. Netko uvijek mora stati i reći: Pusti me proć. <br /><br />
            Taj svakodnevni trenutak postao je ime ulice. A kasnije i naš identitet.
          </h3>
        </div>
        <div class="flex-right">
          <Image
            src={ulica}
            alt="pusti me proc"
            loading="eager"
            class="img-full"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="">
    <div class="container wrapper center">
      <div class="flex-column-reverse">
        <div class="flex-left">
          <Image
            src={svi}
            alt="pusti me proc"
            loading="eager"
            class="img-full"
          />
        </div>
        <div class="flex-right section wrapper">
          <h2 class="txt-label marb-400">PRIJATELJSKI I GOSTOLJUBIVO</h2>
          <h3 class="body-large padb-900">
            Ovo nije sezonski koncept. Ovo je mjesto ukorijenjeno u svakodnevnom
            životu Splita. Otvoreno i zimi, življeno od strane lokalnih ljudi,
            ali i razumljivo turistima.
          </h3>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
