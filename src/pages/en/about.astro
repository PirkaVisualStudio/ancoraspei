---
import MainLayout from "../../layouts/MainLayoutEN.astro";

//image compression
import { Image } from "astro:assets";

//import main site data
import siteInfo from "../../data/siteInfo.json";

//import icons
import { Icon } from "astro-icon/components";

//import images
import vila from "../images/hero/vilaLQ.jpg";
import kuzina from "../images/hero/kuzina.jpg";
import ulica from "../../images/hero/ulica.jpg";
import svi from "../../images/hero/svi.jpg";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="about/"
  pageIndexHr="about/"
  title={"About us" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Get to know us, what we do and how did we end up here" +
    siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="hero-standard bg-prim-acc clr-main-light">
    <div class="container wrapper center">
      <h1 class="txt-label marb-400">ABOUT US</h1>
      <h2 class="h3 padb-900">
        Instructors with many years of experience working at sea in all weather
        conditions and skills learned in real situations and practice at sea.
      </h2>
    </div>
  </section>
</MainLayout>
