---
import MainLayout from "../layouts/MainLayoutHR.astro";
//slider

import ReviewsSlider from "../components/Slider.astro";

//image compression
import { Image } from "astro:assets";

//icons
import { Icon } from "astro-icon";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="hvala"
  pageIndexEn="thanks"
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="section-nav wrapper">
    <div class="">
      <h1 class="h1">HVALA</h1>
      <h2 class="h5">Ovo je H5</h2>
      <a href="/">NATRAG</a>
    </div>
  </section>
</MainLayout>
