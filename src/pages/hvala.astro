---
import MainLayout from "../layouts/MainLayout.astro";
//slider

import TestimonialsSlider from "../components/TestimonialsSlider.astro";
import ReviewsSlider from "../components/ReviewsSlider.astro";

import GalleryGrid from "../components/GalleryGrid.astro";

//image compression
import { Image } from "astro:assets";

import hero from "../images/hero/hero4.jpg";
import services from "../images/media/services.jpg";
import destinations from "../images/media/destinations.jpg";
import testimonial from "../images/media/testimonial.jpg";
import woman from "../images/media/woman-boat.jpg";
import excursions from "../images/media/excursions.jpg";

//icons
import { Icon } from "astro-icon";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="hvala"
  pageIndexEn="thanks"
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="section flex-center txtOnLight padt-900 mart-900">
    <div class="hero-container section">
      <h1 class="h1 section">HVALA</h1>
      <h2 class="h5">Ovo je H5</h2>
      <a href="/">NATRAG</a>
    </div>
  </section>

  <!-- Slider script -->
  <script>
    import "../scripts/slider.js";
  </script>
</MainLayout>
