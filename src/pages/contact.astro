---
import MainLayout from "../layouts/MainLayoutEN.astro";

//image compression
import { Image } from "astro:assets";

//import main site data
import siteInfo from "../data/siteInfo.json";

//import icons
import { Icon } from "astro-icon/components";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="contact/"
  pageIndexHr="kontakt/"
  title={"Contact" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Get in touch" + siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <div>
    <div class="wrapper center">
      <div class="section">
        <h1 class="h1 padt-900 mart-900 padb-400">Contact</h1>
        <h2 class="body-bold body-large padb-200">
          Use a form below to send us inquiry about the service you are
          interested in or use the contact details.
        </h2>
        <p class="body padb-900">We'll try to answer as soon as possible.</p>
        <p class="body-bold padb-100">CONTACT INFO</p>
        <p class="padb-100">
          mail: <a href="mailto:pustimeproc.st@gmail.com"
            >pustimeproc.st@gmail.com</a
          >
        </p>
        <p class="padb-400">
          phone: <a href="tel:0038521675015">+385 21 675 015</a>
        </p>
        <hr class="marb-900" />
      </div>
    </div>
    <form
      name="kontakt-forma"
      id="formContact"
      class="contact-form"
      method="POST"
      data-netlify="true"
      action="/thanks/"
      data-netlify-recaptcha="true"
    >
      <label class="body-bold" for="name">Name:</label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder="John Doe"
        required
      />
      <label class="body-bold" for="email">E-mail:</label>
      <input
        type="email"
        id="email"
        name="email"
        placeholder="info@mail.hr"
        required
      />
      <label class="body-bold" for="message">Message:</label>
      <textarea
        id="message"
        name="message"
        rows="4"
        placeholder="I want to know more about..."
        required></textarea>

      <label class="body mart-900 marb-900 txt-center">
        Please confirm that you are not a robot:
      </label>

      <div
        class="g-recaptcha"
        data-sitekey="6Ld7OC8tAAAAANlIJLgQy9FtdahPdANIas0IOJ4u"
      >
      </div>

      <button type="submit" class="btn-form mart-900">SEND</button>
    </form>
  </div>
</MainLayout>

<!-- Google Captcha -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
