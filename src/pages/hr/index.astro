---
//Main Layout
import MainLayout from "../../layouts/MainLayoutHR.astro";

//import main site data
import siteInfo from "../../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images

import logo from "../../images/logos/pusti_logo_ext_light.svg";
import hero from "../../images/hero/hero3.jpg";
import tece from "../../images/hero/tece.jpg";
import kuzina from "../../images/hero/kuzina.jpg";

//import icons
import { Icon } from "astro-icon/components";

//import components
import ReviewsSlider from "../../components/elements/TestimonialsHR.astro";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexHr=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="center hero-home">
    <div class="hero-mask">
      <Image
        src={hero}
        alt="pusti me proc"
        loading="eager"
        class="hero_image"
      />
    </div>
    <div class="container wrapper">
      <Image
        src={logo}
        alt="pusti me proc logo"
        loading="eager"
        id="heroLogo"
      />

      <div class="hero-cta-btn">
        <a href="/hr/kontakt/"><div class="btn-fill">KONTAKT</div></a>
        <a href="/hr/menu/"><div class="btn-fill">MENU</div></a>
      </div>
    </div>
  </section>

  <!-- services -->

  <section class="section center wrapper txt-center bg-light clr-ter-acc">
    <p class="txt-label padb-400">PUSTI ME PROĆ</p>
    <h1 class="h3 padb-100">Autentična spiza u srcu Splita</h1>
    <p class="body-large padb-900">
      Restoran inspiriran jednom od najužih splitskih ulica, gdje je
      zaglavljivanje dio iskustva.
    </p>
    <a href="/hr/menu/"><div class="btn-fill">MENU</div></a>
  </section>

  <!-- testimonials -->

  <ReviewsSlider />

  <!-- img -->
  <section class="hidden-fade section">
    <Image src={tece} alt="pusti me proc" loading="eager" class="img-full2" />
  </section>

  <!-- cta 1-->
  <section class="center bg-light clr-ter-acc">
    <div class="wrapper-medium center txt-center section-2">
      <p class="txt-label padb-400 hidden-fade delay1">PUSTI ME IST</p>
      <h2 class="h3 padb-400 hidden-fade delay2">Uspori malo.</h2>
      <p class="body-large padb-900 hidden-fade delay3">
        Guštaj u friškoj ribi i domaćoj spizi u laganom okruženju.
      </p>
      <a href="/hr/kontakt/"><div class="btn-fill">KONTAKT</div></a>
    </div>
  </section>

  <!-- img -->
  <section class="hidden-fade section">
    <Image
      src={kuzina}
      alt="pusti me proc kuzina"
      loading="eager"
      class="img-full2"
    />
  </section>

  <!-- cta 2-->
  <section class="center section bg-light clr-ter-acc">
    <div class="wrapper-medium center txt-center section-2">
      <p class="txt-label padb-400 hidden-fade delay1">IZBOR HRANE</p>
      <h2 class="h3 padb-400 hidden-fade delay2">Provjeri naš jelovnik!</h2>
      <p class="body-large padb-900 hidden-fade delay3">
        Check out our menu and find out our prices. Provjeri naš jelovnik i
        cijene, a uz a la carte ponudu također imamo i svakodnevne domaće
        marende.
      </p>
      <a href="/hr/menu/"><div class="btn-fill">MENU</div></a>
    </div>
  </section>
</MainLayout>

<script>
  import "../../scripts/slider.js";
</script>
