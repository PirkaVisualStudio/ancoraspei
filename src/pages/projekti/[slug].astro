---
import MainLayout from "../../layouts/MainLayoutHR.astro";
import ProjectsSlider from "../../components/ProjectsSlider.astro";

import { Image } from "astro:assets";

import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const projectsPosts = await getCollection("projects");

  return projectsPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"projects">;
}
const { post } = Astro.props;

const { Content } = await post.render();
---

<MainLayout
  pageIndex={post.data.index}
  title={`${post.data.title} | Pirka Visual Studio projekt`}
  description={post.data.description_og}
  openGraph={{
    basic: {
      title: `${post.data.title} | Pirka Visual Studio projekt`,
      type: "article",
      image: `${post.data.image.src}`,
    },
  }}
  ,
  extend={{
    meta: [
      {
        name: "author",
        content: "Pirka Visual Studio",
      },

      {
        name: "keywords",
        content: `${post.data.keywords}`,
      },
    ],
  }}
  ,
>
  <section>
    <div class="hero-project" id={post.data.id}>
      <div class="wrapper center">
        <h1 class="h1 padt-900 padb-900">{post.data.title}</h1>
        <p class="body">{post.data.category}</p>
        <p class="body">{post.data.year}</p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="wrapper center">
      <div class="project-img">
        <Image
          src={post.data.image}
          alt={post.data.imageAlt}
          loading="lazy"
          format="avif"
        />
      </div>
    </div>
  </section>

  <section class="project-content section bg-white">
    <div class="flex-columns section wrapper center">
      <div class="flex-left">
        <h2 class="h5 padb-100">Cilj</h2>
        <div class="line-dark-small marb-900"></div>
      </div>
      <div class="flex-right">
        <h3 class="h1 thin padb-400">{post.data.cilj}</h3>
        <p class="body">
          {post.data.ciljContent}
        </p>
      </div>
    </div>

    <div class="flex-columns section wrapper center">
      <div class="flex-left">
        <h2 class="h5 padb-100">Strategija</h2>
        <div class="line-dark-small marb-900"></div>
      </div>
      <div class="flex-right">
        <h3 class="h1 thin padb-400">{post.data.strategija}</h3>
        <p class="body">
          {post.data.strategijaContent}
        </p>
      </div>
    </div>
  </section>

  <section class="wrapper center section">
    <div class="section"><Content /></div>
  </section>

  <ProjectsSlider />

  <!-- Slider script -->
  <script>
    import "../../scripts/slider.js";
  </script>
</MainLayout>
