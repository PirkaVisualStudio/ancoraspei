---
import MainLayout from "../layouts/MainLayoutHR.astro";

//image compression
import { Image } from "astro:assets";

//import icons
import { Icon } from "astro-icon/components";

//import main site data
import siteInfo from "../data/siteInfo.json";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="o-nama"
  pageIndexEn="about"
  title={"O nama" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Tko smo mi?" + siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="wrapper center">
    <div class="container wrapper center">
      <h1 class="h1 padb-800">O nama</h1>
      <p>saznajte malo više o nama</p>
      <form
        name="contact"
        id="formContact"
        class="contact-form"
        method="POST"
        data-netlify="true"
        action="/hvala/"
      >
        <label class="body-bold" for="name">Ime:</label>
        <input type="text" id="name" name="name" placeholder="Ivo" required />
        <label class="body-bold" for="email">E-mail:</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="info@mail.hr"
          required
        />
        <label class="body-bold" for="message">Poruka:</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          placeholder="Zanima me..."
          required></textarea>

        <label class="body mart-900 marb-900 txt-center">
          Molimo potvrdite da niste robot zbog sprječavanja spam pošte:
        </label>

        <button type="submit" class="btn-form mart-900">POŠALJI</button>
      </form>
    </div>
  </section>
</MainLayout>
