---
import MainLayout from "../layouts/MainLayoutHR.astro";

//image compression
import { Image } from "astro:assets";

//import main site data
import siteInfo from "../data/siteInfo.json";

//import icons
import { Icon } from "astro-icon/components";

//import images
import vila from "../images/hero/vilaLQ.jpg";
import kuzina from "../images/hero/kuzina.jpg";
import ulica from "../images/hero/ulica.jpg";
import svi from "../images/hero/svi.jpg";
import boat from "../images/hero/ancora_boat.jpg";
import pajet from "../images/hero/pajet.jpg";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="about/"
  pageIndexHr="o-nama/"
  title={"O nama" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Upoznajte naše instruktore" + siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="hero-standard bg-prim-acc clr-main-light">
    <div class="container wrapper center">
      <h1 class="txt-label marb-400">O NAMA</h1>
      <h2 class="h3 padb-900">
        Instruktori sa višegodišnjim iskustvom plovidbe na moru.
      </h2>
    </div>
  </section>
</MainLayout>
