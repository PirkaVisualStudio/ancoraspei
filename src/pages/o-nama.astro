---
import MainLayout from "../layouts/MainLayoutHR.astro";

//image compression
import { Image } from "astro:assets";
import pattern1 from "../images/renders/pattern1.jpeg";
import pattern2 from "../images/renders/pattern2.jpeg";
import pattern3 from "../images/renders/pattern3.jpeg";
import pattern4 from "../images/renders/pattern4.jpeg";
import render1 from "../images/renders/render1.jpeg";
import render2 from "../images/renders/render2.jpeg";

//import icons
import { Icon } from "astro-icon/components";

//import main site data
import siteInfo from "../data/siteInfo.json";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="o-nama"
  pageIndexEn="about"
  title={"O nama" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Tko smo mi?" + siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="hero-onama center">
    <Image
      src={render1}
      alt="zid interior apartment design"
      format="webp"
      loading="eager"
      class="onama-hero"
    />
    <div class="container wrapper center">
      <h1 class="h1 padb-800">O nama</h1>
      <p>saznajte malo više</p>
    </div>
  </section>

  <section class="wrapper center">
    <div class="container">
      <p class="body-large padb-900">
        Dobrodošli na ZID, studio za uređenje i stiliziranje interijera gdje
        minimalizam susreće toplinu, a sklad prostora obogaćuje suptilna doza
        razigranosti.
      </p>
      <h2 class="h3 padb-400">Strast i posao</h2>
      <p class="body-large padb-900">
        Moje ime je Zorana, dizajnerica interijera i stilistica, školovana u
        renomiranoj školi Mirjane Mikulec. Nakon dugogodišnje karijere u
        financijama, odlučila sam slijediti svoju pravu strast – stvaranje
        interijera koji odišu elegancijom, funkcionalnošću i karakterom. <br
        /><br /> Moja estetika temelji se na čistim linijama, pomno odabranoj rasvjeti
        i spoju unutarnjeg i vanjskog prostora. Vjerujem da svaki prostor treba pričati
        priču svog vlasnika, biti personaliziran, ali istovremeno balansiran i skladan.
        Godinama sam kroz osobne projekte, renovacije i rad s klijentima razvijala
        prepoznatljiv stil koji kombinira dizajnerske komade, vrhunsku rasvjetu i
        prirodne elemente. <br /><br />Danas pomažem klijentima oblikovati
        prostore koji nisu samo estetski privlačni, već i funkcionalni i
        prilagođeni njihovom načinu života. Ako tražite interijer koji odiše
        jednostavnošću, ali ne i jednoličnošću – prostor u kojem ćete se
        osjećati ugodno, inspirirano i povezano s okruženjem – ZID je tu za vas.
        Kontaktirajte nas i zajedno oblikujmo prostor koji priča vašu priču.
      </p>

      <div class="image-container">
        <Image
          src={pattern1}
          alt="zid interior apartment design"
          format="webp"
          loading="eager"
          class="onama-img"
        />
        <Image
          src={pattern2}
          alt="zid interior apartment design"
          format="webp"
          loading="eager"
          class="onama-img"
        />
        <Image
          src={pattern3}
          alt="zid interior apartment design"
          format="webp"
          loading="eager"
          class="onama-img"
        />
      </div>

      <div class="wrapper-medium flex-center">
        <a href="/kontakt/"> <div class="btn-fill marb-900">KONTAKT</div></a>
      </div>

      <h2 class="h3 padb-400">Dizajn koji inspirira</h2>
      <p class="body-large padb-900">
        Dizajn interijera nije samo estetika – to je umjetnost stvaranja
        prostora koji vas nadahnjuje, opušta i reflektira vaš stil života. ZID
        je studio posvećen oblikovanju interijera u kojima se spajaju
        minimalizam, sklad i suptilna razigranost. <br /><br />Posebnu pažnju
        pridajemo rasvjeti kao ključnom elementu atmosfere, pažljivo odabranim
        dizajnerskim komadima i povezivanju unutarnjeg i vanjskog prostora. <br
        /><br />Naš cilj nije stvarati katalog interijera, već domove i prostore
        s osobnošću – funkcionalne, ali jedinstvene. S iskustvom u uređenju
        privatnih i turističkih prostora te formalnim obrazovanjem u dizajnu i
        stiliziranju interijera, nudimo personalizirani pristup svakom projektu.
        Vaša vizija i potrebe su naš glavni fokus, a mi ćemo ih pretočiti u
        prostor u kojem ćete se osjećati kao kod kuće. Ako želite interijer koji
        odiše elegancijom, ravnotežom i promišljenim detaljima – ZID je tu da
        vam pomogne oblikovati prostor koji priča vašu priču.
      </p>
      <div class="image-container">
        <Image
          src={pattern4}
          alt="zid interior apartment design"
          format="webp"
          loading="eager"
          class="onama-img"
        />
        <Image
          src={render1}
          alt="zid interior apartment design"
          format="webp"
          loading="eager"
          class="onama-img"
        />
        <Image
          src={render2}
          alt="zid interior apartment design"
          format="webp"
          loading="eager"
          class="onama-img"
        />
      </div>
    </div>
  </section>
</MainLayout>
