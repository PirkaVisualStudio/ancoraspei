---
import MainLayout from "../layouts/MainLayoutHR.astro";

//image compression
import { Image } from "astro:assets";

//import main site data
import siteInfo from "../data/siteInfo.json";

//import icons
import { Icon } from "astro-icon/components";

//import images
import vila from "../images/hero/vilaLQ.jpg";
import kuzina from "../images/hero/kuzina.jpg";
import ulica from "../images/hero/ulica.jpg";
import svi from "../images/hero/svi.jpg";
import boat from "../images/hero/ancora_boat.jpg";
import franebozo from "../images/hero/franeibozo.jpg";
import pajet from "../images/hero/pajet.jpg";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="about/"
  pageIndexHr="o-nama/"
  title={"O nama" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Upoznajte naše instruktore" + siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="hero-standard bg-prim-acc clr-main-light">
    <div class="container wrapper center">
      <h1 class="txt-label marb-400">O NAMA</h1>
      <h2 class="h3 padb-900">
        Instruktori sa višegodišnjim iskustvom plovidbe na moru.
      </h2>
    </div>
  </section>

  <section class="">
    <div class="container wrapper center">
      <div class="flex-column">
        <div class="flex-left section wrapper">
          <h2 class="txt-label marb-100">TKO SMO MI?</h2>
          <h3 class="h5 padb-400">Profesionalci i zaljubljenici u more</h3>
          <p class="body padb-900">
            Ancora Spei je projekt dvojice prijatelja koji su svoje
            profesionalno znanje i iskustvo stekli kroz dugogodišnji rad na moru
            u ulozi skipera. Ljubav prema moru i ovoj profesiji dovela nas je do
            ideje da svoje znanje i iskustvo podijelimo sa onima koji žele više
            od teorije - stvarno iskustvo koje se može steći samo u plovidbi
            morem kako bi odbacili strah i dobili samopouzdanje u samostalnoj
            plovidbi. Svjesni da postoji potreba za učenjem vještina koje se
            nemogu naučiti iz knjige pokrenuli smo ovaj projekt kako bismo
            svakome tko želi upravljati brodom pružili priliku da se odvaži
            isploviti, stekne iskustvo i pronađe sigurnost za kormilom.
          </p>
          <a href="/kontakt/"><div class="btn-fill">KONTAKT</div></a>
        </div>
        <div class="flex-right">
          <Image
            src={franebozo}
            alt="ancora spei na brodu"
            loading="eager"
            class="img-full"
          />
        </div>
      </div>
    </div>
  </section>
</MainLayout>
