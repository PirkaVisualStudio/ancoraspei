---
import MainLayout from "../layouts/MainLayout.astro";
import GalleryGrid from "../components/GalleryGrid.astro";

//image compression
import { Image } from "astro:assets";
import hero from "../images/hero/hero2.jpg";

//icons
import { Icon } from "astro-icon";

const {
  title,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang="en"
  pageIndex="gallery"
  pageIndexEn="gallery"
  title="Gallery | Elamio Yachting"
  charset={charset}
  description="Check our exclusive gallery | Elamio Yachting "
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
  noindex
  nofollow
>
  <div class="hero_content txtOnDark txt-center flex-center">
    <div class="black"></div>
    <Image
      src={hero}
      alt="boat"
      format="avif"
      loading="lazy"
      class="hero-img"
    />
    <div class="heroContainer-default">
      <h1 class="h1">Gallery</h1>

      <h2 class="body">Check out our image gallery from our past trips</h2>
    </div>
  </div>
</MainLayout>

<script>
  import "../scripts/gallery.js";
</script>
