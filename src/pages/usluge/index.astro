---
import MainLayout from "../../layouts/MainLayoutHR.astro";

//import components

import ProjectsSlider from "../../components/ProjectsSlider.astro";

//image compression
import { Image } from "astro:assets";
import volvo from "../../images/projects/project-volvo.jpg";
import video from "../../images/media/videoproduction.jpg";
import design from "../../images/projects/makamakaAcai/makamakaAcaiCard.jpg";
import poster from "../../images/hero/poster.jpg";

//import icons
import { Icon } from "astro-icon/components";

//import main site data
import siteInfo from "../../data/siteInfo.json";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="usluge"
  pageIndexEn="services"
  title={"Usluge" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Pogledajte pregled naših usluge koje nudimo" +
    siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="section-nav center wrapper">
    <div class="section">
      <h1 class="h2 padb-400">Digitalni svijet ne mora biti zastrašujući</h1>
      <h2 class="h4">
        Vaš proizvod ili usluga zaslužuju <span class="clr-prim-acc"
          >dobar glas</span
        >
      </h2>
    </div>
    <div class="indent">
      <p class="body-large padb-100">
        - svi potrebni alati za promociju Vašeg proizvoda ili branda.
      </p>
      <p class="body-large padb-100">- pomažemo malim i velikim tvrtkama</p>
      <p class="body-large padb-400">
        - ispričajte svoju priču i istaknite se u mnoštvu
      </p>
    </div>
  </section>

  <section class="section center wrapper">
    <div class="services">
      <div class="container">
        <Image
          src={volvo}
          alt="pirka visual design fotografija"
          format="avif"
          loading="eager"
        />

        <h2 class="h4 padb-200 title">fotografija</h2>

        <div>
          <a href="/usluge/fotografija/" class="link">
            <p class="txt-label">Saznaj više</p><Icon
              name="mdi:arrow-right"
              width={28}
            /></a
          >
        </div>
      </div>

      <div class="container">
        <Image
          src={video}
          alt="pirka visual design fotografija"
          format="avif"
          loading="eager"
        />

        <h2 class="h4 padb-200 title">video</h2>

        <div>
          <a href="/usluge/videoprodukcija/" class="link">
            <p class="txt-label">Saznaj više</p><Icon
              name="mdi:arrow-right"
              width={28}
            /></a
          >
        </div>
      </div>

      <div class="container">
        <Image
          src={design}
          alt="pirka visual design fotografija"
          format="avif"
          loading="eager"
        />

        <h2 class="h4 padb-200 title">dizajn</h2>

        <div>
          <a href="/usluge/dizajn/" class="link">
            <p class="txt-label">Saznaj više</p><Icon
              name="mdi:arrow-right"
              width={28}
            /></a
          >
        </div>
      </div>

      <div class="container">
        <Image
          src={poster}
          alt="pirka visual design fotografija"
          format="avif"
          loading="eager"
        />

        <h2 class="h4 padb-200 title">marketing</h2>

        <div>
          <a href="/usluge/drustvene-mreze/" class="link">
            <p class="txt-label">Saznaj više</p><Icon
              name="mdi:arrow-right"
              width={28}
            /></a
          >
        </div>
      </div>
    </div>
  </section>

  <ProjectsSlider />
</MainLayout>

<!-- Slider script -->
<script>
  import "../../scripts/slider.js";
</script>
