---
import MainLayout from "../../layouts/MainLayoutHR.astro";

//import components

import ProjectsSlider from "../../components/ProjectsSlider.astro";
import Services from "../../components/elements/Services.astro";

//image compression
import { Image } from "astro:assets";
import volvo from "../../images/projects/project-volvo.jpg";
import video from "../../images/media/videoproduction.jpg";
import design from "../../images/projects/makamakaAcai/makamakaAcaiCard.jpg";
import poster from "../../images/hero/poster.jpg";

//import icons
import { Icon } from "astro-icon/components";

//import main site data
import siteInfo from "../../data/siteInfo.json";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="usluge"
  pageIndexEn="services"
  title={"Usluge" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Pogledajte pregled naših usluge koje nudimo" +
    siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="section-nav center wrapper">
    <div class="section">
      <h1 class="h2 padb-400">Digitalni svijet ne mora biti zastrašujući</h1>
      <h2 class="h4">
        Vaš proizvod ili usluga zaslužuju <span class="clr-prim-acc"
          >dobar glas</span
        >
      </h2>
    </div>
    <div class="indent">
      <p class="body-large padb-100">
        - svi potrebni alati za promociju Vašeg proizvoda ili branda.
      </p>
      <p class="body-large padb-100">- pomažemo malim i velikim tvrtkama</p>
      <p class="body-large padb-400">
        - ispričajte svoju priču i istaknite se u mnoštvu
      </p>
    </div>
  </section>

  <section class="section center">
    <section class="kanban-services wrapper-medium section" id="kanbanServices">
      <div class="item item-1">
        <div class="padl-200">
          <h2 class="h3 padb-200">
            usluge<span class="clr-sec-acc">*</span>
          </h2>
          <p class="body-large">
            što zapravo nudimo i što možete očekivati od nas
          </p>
        </div>
      </div>
      <div class="item item-2">
        <Services
          title="fotografija"
          desc="Profesionalna fotografija za vaš brand, proizvod, event ili interijer. Pokažite vašu priču cijelom svijetu."
          imageSrc={volvo}
          imageAlt="clapboard"
          url="/usluge/fotografija/"
        />
      </div>
      <div class="item item-3">
        <Services
          title="video produkcija"
          desc="Vrhunska video produkcija. Snimanje promo materijala, video za društvene mreže, snimanje iz zraka."
          imageSrc={video}
          imageAlt="clapboard"
          url="/usluge/fotografija/"
        />
      </div>
      <div class="item item-4">
        <Services
          title="grafički dizajn"
          desc="Izradi vizualni identitet svoga branda te povećaj vidljivost i prepoznatljivost"
          imageSrc={design}
          imageAlt="clapboard"
          url="/usluge/fotografija/"
        />
      </div>
      <div class="item item-5">
        <Services
          title="marketing"
          desc="Promocija putem društvenih mreža, Google Ads oglasi, marketinške kampanje"
          imageSrc={poster}
          imageAlt="clapboard"
          url="/usluge/drustvene-mreze/"
        />
      </div>
      <div class="item item-6">
        <div class="padl-200">
          <h1 class="h3 padb-600">
            <span class="clr-sec-acc">*</span> javite nam se
          </h1>

          <a href="/kontakt/"> <div class="btn-fill-rounded">KONTAKT</div> </a>
        </div>
      </div>
    </section>
  </section>

  <ProjectsSlider />
</MainLayout>

<!-- Slider script -->
<script>
  import "../../scripts/slider.js";
</script>
