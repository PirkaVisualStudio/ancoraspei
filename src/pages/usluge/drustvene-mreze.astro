---
import MainLayout from "../../layouts/MainLayoutHR.astro";

//import components

//image compression
import { Image } from "astro:assets";
import social from "../../images/projects/makamakaAcai/makamakaAcaiModboard.jpg";

//import icons
import { Icon } from "astro-icon/components";

//import main site data
import siteInfo from "../../data/siteInfo.json";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="drustvene-mreze"
  pageIndexEn="social-media"
  title={"Usluge održavanja društvenih mreža" +
    siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Frustriraju vas društvene mreže? Teško se snalazite u digitalnom svijetu? Želite se oglašavati ali ne znate kako? Vratite pouzdanje u svoj posao i budite u korak s vremenom. Pošaljite nam svoj email i mi ćemo Vas kontaktirati." +
    siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <div class="section-nav wrapper center flex-column">
    <div class="flex-left section">
      <h1 class="h2 padb-400">Nudimo usluge održavanja društvenih mreža</h1>
      <div class="">
        <p class="body-large padb-100">- frustriraju vas društvene mreže?</p>
        <p class="body-large padb-100">
          - teško se snalazite u digitalnom svijetu?
        </p>
        <p class="body-large padb-400">
          - želite se oglašavati ali ne znate kako?
        </p>
      </div>
      <h2 class="h5 padb-200">
        Vratite pouzdanje u svoj posao i budite u korak s vremenom.
      </h2>

      <p class="body">Pošaljite nam svoj email i mi ćemo Vas kontaktirati.</p>
      <form
        name="social"
        id="formSocial"
        class="contact-form"
        method="POST"
        data-netlify="true"
        action="/hvala/"
      >
        <label class="txt-label" for="email">E-mail:</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="info@gmail.com"
          required
        />
        <button type="submit">POŠALJI</button>
      </form>
    </div>

    <div class="flex-right">
      <Image
        src={social}
        alt="drustvene mreže"
        format="avif"
        loading="eager"
        class="flex-img-full"
      />
    </div>
  </div>

  <section class="section relative"></section>
</MainLayout>

<!-- Slider script -->
<script>
  import "../../scripts/slider.js";
</script>
