---
import MainLayout from "../../layouts/MainLayoutHR.astro";

//import components
import ProjectsSlider from "../../components/ProjectsSlider.astro";
import PhotoBox from "../../components/elements/PhotographyBoxes.astro";

//image compression
import { Image } from "astro:assets";
import photography from "../../images/pages/photography/photography.jpg";
import wedding from "../../images/pages/photography/weddingFrane.jpg";
import portrait from "../../images/pages/photography/portrait.jpg";
import forketta from "../../images/pages/photography/forketta.jpg";

//import icons
import { Icon } from "astro-icon/components";

//import main site data
import siteInfo from "../../data/siteInfo.json";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="fotografija"
  pageIndexEn="photography"
  title={"Fotografija" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Profesionalna fotografija" + siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="hero-photography txt-on-dark">
    <Image
      src={photography}
      alt="pirka visual design fotografija"
      format="avif"
      loading="eager"
    />
    <div class="wrapper center container">
      <div class="title">
        <h1 class="h1 padb-200">Fotografija.</h1>
        <h2 class="h5">Pogledaj neke od naših nedavnih projekata</h2>
      </div>
    </div>
  </section>
  <section class="photo-categories wrapper center section">
    <div class="container">
      <PhotoBox
        title="FOOD"
        desc="GARDEN | ŠUG"
        imageSrc={photography}
        imageAlt="sug restaurant"
      />
    </div>

    <div class="container">
      <PhotoBox
        title="LJUBAV NA OTOKU"
        desc="ART | PEOPLE | WEDDING"
        imageSrc={wedding}
        imageAlt="sug restaurant"
      />
    </div>

    <div class="container">
      <PhotoBox
        title="PORTRETI"
        desc="OSOBE | DJECA"
        imageSrc={portrait}
        imageAlt="sug restaurant"
      />
    </div>

    <div class="container">
      <PhotoBox
        title="FORKETTA"
        desc="HOTEL | FOOD"
        imageSrc={forketta}
        imageAlt="forketta hotel fanat"
      />
    </div>
  </section>
</MainLayout>
