---
import MainLayout from "../layouts/MainLayoutEN.astro";

//image compression
import { Image } from "astro:assets";

//import main site data
import siteInfo from "../data/siteInfo.json";

//import icons
import { Icon } from "astro-icon/components";

//import images
import vila from "../images/hero/vilaLQ.jpg";
import kuzina from "../images/hero/kuzina.jpg";
import menu from "../images/hero/menu.jpg";

const {
  title,
  description,
  lang,
  charset,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="menu/"
  pageIndexHr="menu/"
  title={"Menu" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Check out our offer" + siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->

  <section class="hero-standard bg-prim-acc clr-main-light">
    <div class="container wrapper center">
      <div class="content">
        <h1 class="txt-label marb-400">MENU</h1>
        <h2 class="h3 padb-900">Check out our menu and our offer.</h2>
        <div class="menu-links">
          <ul>
            <li><a href="/media/jelovnik.pdf">A la carte menu</a></li>
            <li><a href="/media/vinska_karta.pdf">Wine card</a></li>
            <li><a href="/media/pice.pdf">Drinks menu</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
  <Image
    src={menu}
    alt="pusti me proc kuzina"
    loading="eager"
    class="img-full"
  />
</MainLayout>
