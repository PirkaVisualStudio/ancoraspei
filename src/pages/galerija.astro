---
import MainLayout from "../layouts/MainLayoutHR.astro";

import Gallery1 from "../components/gallery/Gallery1.astro";

//image compression
import { Image } from "astro:assets";
import book from "../images/default/book.jpg";
//import icons
import { Icon } from "astro-icon/components";

//import main site data
import siteInfo from "../data/siteInfo.json";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="galerija"
  pageIndexEn="gallery"
  title={"Galerija fotografija" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Pogledajte neke od naših projekata" +
    siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="hero-onama center">
    <Image
      src={book}
      alt="zid interior apartment design"
      format="webp"
      loading="eager"
      class="onama-hero"
    />
    <div class="container wrapper center">
      <h1 class="h1 padb-800">Galerija</h1>
      <p>Pogledajte galeriju naših radova</p>
    </div>
  </section>

  <section class="wrapper center">
    <Gallery1 />
  </section>

  <script>
    import "../scripts/gallery.js";
  </script>
</MainLayout>
