---
import MainLayout from "../layouts/MainLayout.astro";

//image compression
import { Image } from "astro:assets";
import hero from "../images/hero/hero2.jpg";
import destinations from "../images/media/destinations.jpg";

//icons
import { Icon } from "astro-icon";

const {
  title,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang="en"
  pageIndex="cruises"
  pageIndexEn="cruises"
  title="Cruises | Elamio Yachting"
  charset={charset}
  description="Cruises for everyone to enjoy | Elamio Yachting"
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
  noindex
  nofollow
>
  <div class="hero_content txtOnDark txt-center flex-center">
    <div class="black"></div>
    <Image
      src={destinations}
      alt="destinations in croatia"
      format="avif"
      loading="lazy"
      class="hero-img"
    />
    <div class="heroContainer-default">
      <h1 class="h1">Cruises</h1>

      <h2 class="body">Embrace the Mediterrannean in it's full bliss</h2>
    </div>
  </div>
</MainLayout>
