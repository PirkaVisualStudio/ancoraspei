---
import MainLayout from "../layouts/MainLayoutHR.astro";

//import components
import ProjectsSlider from "../components/ProjectsSlider.astro";

//image compression
import { Image } from "astro:assets";

//import icons
import { Icon } from "astro-icon/components";

//import main site data
import siteInfo from "../data/siteInfo.json";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="usluge"
  pageIndexEn="services"
  title={"Usluge" + siteInfo.map((i) => i.brand_tag)}
  charset={charset}
  description={"Pogledajte pregled naših usluge koje nudimo" +
    siteInfo.map((i) => i.brand_tag)}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="section-nav wrapper flex-center">
    <div class="">
      <h1 class="h1 padt-900">Web u izradi</h1>
      <h2 class="h5 padb-200">
        Web stranica se trenutno izrađuje. Hvala na strpljenju.
      </h2>
      <p class="padb-200">
        Molimo pokušajte sa nekim drugim sadržajem ili se vratite na <a href="/"
          >početak.</a
        >
      </p>
    </div>
  </section>

  <ProjectsSlider />
</MainLayout>

<!-- Slider script -->
<script>
  import "../scripts/slider.js";
</script>
