---
//Main Layout
import MainLayout from "../layouts/MainLayoutEN.astro";

//import main site data
import siteInfo from "../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images

import hero from "../images/hero/herocover.jpg";
import vila from "../images/hero/vila.jpg";
import vila2 from "../images/hero/vila2.jpg";

//import icons
import { Icon } from "astro-icon/components";

//import components
import PhotoSlider from "../components/elements/PhotoSlider.astro";
import ReviewsSlider from "../components/elements/TestimonialsHR.astro";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexHr=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="center hero-home">
    <div class="hero-mask">
      <Image src={vila} alt="maven mib" loading="eager" class="hero_image" />
    </div>
    <div class="container wrapper">
      <p class="h1 marb-400 clr-main-light">MAVEN MIB</p>
      <p class="body-large clr-main-light">
        A real estate project management for your investment in Croatia.
      </p>
      <p class="body-large marb-900 clr-main-light">
        We handle the paperwork! You enjoy the view.
      </p>
      <a href="/contact/"><div class="btn-fill">CONTACT</div></a>
    </div>
  </section>

  <!-- services -->

  <section class="section services center wrapper hidden-fade">
    <h2 class="h2 padb-100">Services</h2>
    <p class="body-large padb-100">What we do?</p>
    <div class="line-acc-full marb-900"></div>
    <div class="container center">
      <div class="box 1">
        <h2 class="body-large-bold">SURVEYING</h2>
        <p class="body">Filed surveying and geodetic services</p>
        <Image src={hero} alt="maven surveying" loading="eager" />
      </div>
      <div class="box 2">
        <h2 class="body-large-bold">SURVEYING</h2>
        <p class="body">Filed surveying and geodetic services</p>
        <Image src={hero} alt="maven surveying" loading="eager" />
      </div>
      <div class="box 3">
        <h2 class="body-large-bold">SURVEYING</h2>
        <p class="body">Filed surveying and geodetic services</p>
        <Image src={hero} alt="maven surveying" loading="eager" />
      </div>
    </div>
  </section>

  <!-- testimonials -->

  <ReviewsSlider />

  <!-- cta 1-->
  <section class="center">
    <div class="wrapper-medium center txt-center section-2">
      <p class="txt-label padb-400 clr-prim-acc hidden-fade delay1">
        GET IN TOUCH
      </p>
      <h2 class="h3 padb-400 hidden-fade delay2">
        You want to invest in Croatia? Don't know where to start?
      </h2>
      <p class="body-large padb-900 hidden-fade delay3">
        We can help you get clear objectives and all the information for
        starting a project! We offer complete services that you might need when
        investing in real estate business in Croatia. You want to build a house,
        buy a property or invest? We can help you!
      </p>
      <a href="/kontakt/"><div class="btn-fill">CONTACT</div></a>
    </div>
  </section>

  <!-- faq -->

  <section class="faq section hidden-fade" id="faqa">
    <div class="wrapper center">
      <div class="container">
        <h2 class="h2 padb-400">FAQ's</h2>
        <p class="body-large padb-400">
          Frequently asked questions! If you want to know more please contact us <a
            href="/contact/"
          >
            HERE!</a
          >
        </p>
        <div class="question">
          <div class="accordion">
            Question 1<Icon
              class="faq-icon"
              name="mdi:keyboard-arrow-down"
              width={28}
              height={28}
            />
          </div>

          <div class="panel">
            <p class="body">
              Lorem, ipsum dolor sit amet consectetur adipisicing elit.
