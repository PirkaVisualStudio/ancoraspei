---
//Main Layout
import MainLayout from "../layouts/MainLayoutEN.astro";

//import main site data
import siteInfo from "../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images

import hero from "../images/hero/hero.jpg";
import vila from "../images/hero/vilaLQ.jpg";
import vila2 from "../images/hero/vila2.jpg";
import logo from "../images/logos/pusti_logo_ext_light.svg";

//import icons
import { Icon } from "astro-icon/components";

//import components
import PhotoSlider from "../components/elements/PhotoSlider.astro";
import ReviewsSlider from "../components/elements/TestimonialsHR.astro";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexHr=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="center hero-home">
    <div class="hero-mask">
      <Image src={hero} alt="maven mib" loading="eager" class="hero_image" />
    </div>
    <div class="container wrapper">
      <Image
        src={logo}
        alt="pusti me proc logo"
        loading="eager"
        id="heroLogo"
      />

      <a href="/contact/"><div class="btn-fill">CONTACT</div></a>
    </div>
  </section>

  <!-- services -->

  <section class="section center wrapper txt-center">
    <p class="txt-label padb-400">PAUSE HERE</p>
    <h1 class="h3 padb-100">Authentic food in a heart of Split</h1>
    <p class="body-large padb-100">
      Lorem, ipsum dolor sit amet consectetur adipisicing elit. Vero ut dolor
      quos earum quas sit tempore recusandae in excepturi pariatur ullam
      distinctio rerum et dolore facilis nam similique, labore magni.
    </p>
  </section>

  <!-- testimonials -->

  <ReviewsSlider />

  <!-- cta 1-->
  <section class="center">
    <div class="wrapper-medium center txt-center section-2">
      <p class="txt-label padb-400 hidden-fade delay1">PAUSE HERE</p>
      <h2 class="h3 padb-400 hidden-fade delay2">Life moves slow</h2>
      <p class="body-large padb-900 hidden-fade delay3">
        Enjoy our authentic Croatian food in a cozy atmosphere
      </p>
      <a href="/kontakt/"><div class="btn-fill">CONTACT</div></a>
    </div>
  </section>

  <!-- img -->
  <section class="hidden-fade section">
    <Image src={hero} alt="maven mib" loading="eager" class="img-full" />
  </section>

  <!-- cta 2-->
  <section class="center section">
    <div class="wrapper-medium center txt-center section-2">
      <p class="txt-label padb-400 clr-prim-acc hidden-fade delay1">
        THE FOOD CHOICE
      </p>
      <h2 class="h3 padb-400 hidden-fade delay2">Check out our menu!</h2>
      <p class="body-large padb-900 hidden-fade delay3">
        Check out our menu and find out our prices.
      </p>
      <a href="/kontakt/"><div class="btn-fill">MENU</div></a>
    </div>
  </section>

  <!-- cta 3-->
  <section class="cta section center wrapper hidden-fade">
    <div class="container">
      <div class="flex-column">
        <div class="flex-left">
          <Image src={hero} alt="maven mib" loading="eager" class="img-full" />
        </div>
        <div class="flex-right">
          <h2 class="h2 padb-400">Title 3</h2>
          <p class="body padb-400">
            Lorem ipsum dolor sit amet consectetur adipisicing elit. Alias dicta
            maiores quo quod adipisci officiis esse incidunt temporibus est vel,
            assumenda quasi, veniam quisquam cum, consequuntur cumque ullam
            tempore maxime!
          </p>
          <a href="/contact/"><div class="btn-fill">CONTACT</div></a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import "../scripts/slider.js";
  import "../scripts/accordion.js";
</script>
