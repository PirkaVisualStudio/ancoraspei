---
//Main Layout
import MainLayout from "../layouts/MainLayout.astro";

//import main site data
import siteInfo from "../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images
import hero from "../images/hero/hero4.jpg";

//import icons
import { Icon } from "astro-icon";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexEn=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="section-nav flex-center">
    <div class="section flex-column flex-gap-05">
      <h1 class="h1">Ovo je H1</h1>
      <h2 class="h5">Ovo je H5</h2>
      <a href="/en/">ENGLISH</a>
      <a href="/test/">TEST STRANICA</a>
      <a href="/hvala/">HVALA</a>
      <a href="/styleguide/">STYLEGUIDE</a>
    </div>
  </section>
</MainLayout>
