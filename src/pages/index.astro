---
//Main Layout
import MainLayout from "../layouts/MainLayout.astro";

//import main site data
import siteInfo from "../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images
import hero from "../images/hero/hero.jpg";

//import icons
import { Icon } from "astro-icon";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexEn=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="section-nav wrapper center">
    <div class="">
      <Image
        src={hero}
        alt="pirka visual design"
        format="avif"
        loading="eager"
        class="hero-img img-rounded mart-900"
      />
    </div>
  </section>

  <section class="section wrapper center">
    <div class="flex-row">
      <div class="flex-left padr-200">
        <h1 class="h1 padb-600" data-scroll data-scroll-speed="0.1">
          Pirka Visual Studio
        </h1>
        <h2 class="h4 padb-600" data-scroll data-scroll-speed="0.13">
          Digitalna rješenja za vaše poslovanje
        </h2>
        <p class="body padb-900" data-scroll data-scroll-speed="0.16">
          Kompletna ponuda digitalnih usluga. Videoprodukcija, fotografija,
          grafički i web dizajn te digitalni marketing sve na jednom mjestu.
        </p>
        <div data-scroll data-scroll-speed="0.20">
          <a href="#"><div class="btn-fill marr-200">ZATRAŽI PONUDU</div></a>
          <a href="#"><div class="btn-fill">USLUGE</div></a>
        </div>
      </div>
      <div class="flex-right">
        <Image
          src={hero}
          alt="pirka visual design"
          format="avif"
          loading="eager"
          class="img-rounded"
        />
      </div>
    </div>
  </section>
</MainLayout>
