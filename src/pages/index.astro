    </div>
  </section>

  <!-- img -->
  <section class="hidden-fade section">
    <Image src={vila} alt="maven mib" loading="eager" class="img-full" />
  </section>

  <!-- cta 2-->
  <section class="center section">
    <div class="wrapper-medium center txt-center section-2">
      <p class="txt-label padb-400 clr-prim-acc hidden-fade delay1">
        GET IN TOUCH
      </p>
      <h2 class="h3 padb-400 hidden-fade delay2">
        You want to invest in Croatia? Don't know where to start?
      </h2>
      <p class="body-large padb-900 hidden-fade delay3">
        We can help you get clear objectives and all the information for
        starting a project!
      </p>
      <a href="/kontakt/"><div class="btn-fill">CONTACT</div></a>
    </div>
  </section>

  <!-- cta 3-->
  <section class="cta section center wrapper hidden-fade">
    <div class="container">
      <div class="flex-column">
        <div class="flex-left">
          <Image src={vila} alt="maven mib" loading="eager" class="img-full" />
        </div>
        <div class="flex-right">
          <h2 class="h2 padb-400">What is your dream home?</h2>
          <p class="body padb-400">
            Lorem ipsum dolor sit amet consectetur adipisicing elit. Alias dicta
