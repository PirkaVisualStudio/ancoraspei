---
//Main Layout
import MainLayout from "../layouts/MainLayoutHR.astro";

//import main site data
import siteInfo from "../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images
import logo from "../images/logos/pirka_logo_dark.svg";
import peskarija from "../images/hero/peskarija.jpg";
import billboard from "../images/hero/billboard.jpg";

import tecada from "../videos/tecada.mp4";

//import icons
import { Icon } from "astro-icon/components";

//import components
import VideoSlider from "../components/elements/VideoSlider.astro";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexEn=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="center hero-home bg-light">
    <div class="container wrapper center">
      <Image
        src={logo}
        alt="pirka visual design logotip"
        loading="eager"
        id="heroLogo"
        class="padb-900"
      />
      <p class="body-bold">Next Level Video Production & photography.</p>
    </div>
  </section>

  <!-- VIDEO SLIDERS-->
  <section class="videos bg-light section">
    <div class="wrapper-medium center txt-center">
      <h1 class="h3 clr-prim-acc padb-400">
        Profesionalna videoprodukcija i fotografija
      </h1>
      <p class="body-large clr-prim-acc">
        Nudimo usluge video snimanja i fotografiranja kao i snimanje iz zraka za
        vaš brand, proizvod, nekretninu ili eventove
      </p>
    </div>
    <div class="container"><VideoSlider /></div>
  </section>

  <!-- video -->
  <section class="center bg-light">
    <div class="wrapper-medium center txt-center section">
      <p class="txt-label padb-400">KONTAKTIRAJTE NAS</p>
      <h1 class="h3 clr-prim-acc padb-400">Trebaš video? Ili fotografiju?</h1>
      <p class="body-large clr-prim-ac padb-900">
        Javit nam se i prepustite vaš projekt u naše ruke.
      </p>
      <a href="/kontakt"><div class="btn-fill">KONTAKT</div></a>
    </div>
    <div class="container center">
      <video loop autoplay muted class="video_full">
        <source src={tecada} type="video/mp4" />
      </video>
    </div>
  </section>
  <!-- video
  <Image
    src={peskarija}
    alt="pirka visual design logotip"
    loading="eager"
    class="img-full"
  />-->
</MainLayout>

<script>
  import "../scripts/slider.js";
</script>
