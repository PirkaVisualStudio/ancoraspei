---
//Main Layout
import MainLayout from "../layouts/MainLayoutHR.astro";

//import main site data
import siteInfo from "../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images
import hero from "../images/hero/hero.jpg";
import hero2 from "../images/hero/hero2.jpg";
import logoBadge from "../images/logos/pirka_logo_badge.svg";
import poster from "../images/hero/poster.jpg";
import blue from "../images/kanban/blue.jpg";
import red from "../images/kanban/red.jpg";
import green from "../images/kanban/green.jpg";
import yellow from "../images/kanban/yellow.jpg";

//import icons
import { Icon } from "astro-icon";

//import components
import ProjectsSlider from "../components/ProjectsSlider.astro";
import ProjectsAll from "../components/ProjectsAll.astro";
import ServiceBox from "../components/elements/ServiceBox.astro";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexEn=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="section-nav center hero bg-light">
    <div class="hero-content flex-column-reverse center txt-left">
      <div class="flex-left section center">
        <div class="text-padding">
          <h1 class="h1 padb-600">
            Pronađi svoj <br />
            <span class="clr-prim-acc">identitet</span>
          </h1>
          <h2 class="h3 padb-600">Digitalna rješenja za vaše poslovanje</h2>

          <div>
            <a href="#"
              ><div class="btn-fill marr-200 marb-200">ZATRAŽI PONUDU</div></a
            >
            <a href="#"><div class="btn-fill marb-200">USLUGE</div></a>
          </div>
        </div>
      </div>
      <div class="flex-right">
        <Image
          src={poster}
          alt="pirka visual design"
          format="avif"
          loading="eager"
          class="hero-img"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="flex-center">
      <p class="body-bold">
        <a href="/usluge/"> usluge</a> / <a href="/kontakt/">kontakt</a> /<a
          href="/projekti/"
        >
          projekti</a
        >
      </p>
    </div>

    <div class="flex-center hero-social padb-900">
      <a href="https://www.instagram.com/pirkavisualstudio/" target="_blank"
        ><Icon
          class="socialNavIcon"
          pack="ri"
          name="instagram-fill"
          width="28"
        /></a
      >
      <a href="https://www.facebook.com/pirkavisualstudio" target="_blank"
        ><Icon
          class="socialNavIcon"
          pack="ant-design"
          name="facebook-filled"
          width="30"
        /></a
      >
      <a href="https://www.behance.net/franemdobrovi/moodboards" target="_blank"
        ><Icon class="socialNavIcon" pack="el" name="behance" width="24" /></a
      >

      <a
        href="https://www.youtube.com/channel/UCvGwiHVAWCmZQiLfR9x85gQ"
        target="_blank"
        ><Icon
          class="socialNavIcon"
          pack="ri"
          name="youtube-fill"
          width="36"
        /></a
      >
    </div>
  </section>

  <section class="kanban wrapper-medium clr-prim-acc">
    <div class="item item-1">
      <div>
        <h2 class="h3 padb-200">
          digitalni alati za svakoga <span class="clr-sec-acc">*</span>
        </h2>
        <p class="body-large">
          usluga koju trebaš za svaki dan svoga poslovanja
        </p>
      </div>
    </div>
    <div class="item item-2"><ServiceBox /></div>
    <div class="item item-3"></div>
    <div class="item item-4"></div>

    <div class="item item-5"></div>

    <div class="item item-6">
      <div>
        <h2 class="h3 padb-200">
          digitalni alati za svakoga <span class="clr-sec-acc">*</span>
        </h2>
        <p class="body-large">
          usluga koju trebaš za svaki dan svoga poslovanja
        </p>
      </div>
    </div>
  </section>
  <ProjectsSlider />
</MainLayout>

<!-- Slider script -->
<script>
  import "../scripts/slider.js";
</script>
