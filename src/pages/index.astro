---
//Main Layout
import MainLayout from "../layouts/MainLayoutHR.astro";

//import main site data
import siteInfo from "../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images

import hero from "../images/hero/hero.jpg";
import boat from "../images/hero/ancora_boat.jpg";
import pajet from "../images/hero/pajet.jpg";
import tece from "../images/hero/tece.jpg";
import kuzina from "../images/hero/kuzina.jpg";
import vila from "../images/hero/vilaLQ.jpg";
import vila2 from "../images/hero/vila2.jpg";
import logo from "../images/logos/ancora_logo_full_prim.svg";
import franebozo from "../images/hero/franeibozo.jpg";

//import icons
import { Icon } from "astro-icon/components";

//import components
import PhotoSlider from "../components/elements/PhotoSlider.astro";
import ReviewsSlider from "../components/elements/TestimonialsHR.astro";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexHr=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="center hero-home">
    <div class="hero-mask">
      <Image
        src={hero}
        alt="ancora spei splitska vrata"
        loading="eager"
        class="hero_image"
      />
    </div>
    <div class="container wrapper txt-center">
      <Image src={logo} alt="ancora spei logo" loading="eager" id="heroLogo" />
      <h1 class="h5 padb-900">
        Praktična edukacija na moru za sigurno i samostalno upravljanje brodicom
      </h1>
      <div class="hero-cta-btn">
        <a href="/kontakt/"><div class="btn-fill">KONTAKT</div> </a>
        <a href="https://forms.gle/Aky9XmintDXXsJ9z5" target="_blank"
          ><div class="btn-fill">PRIJAVA ZA GRUPE</div>
        </a>
      </div>
    </div>
  </section>

  <!-- grupe -->

  <section
    class="section groups center wrapper txt-center bg-light clr-ter-acc"
  >
    <div class="container">
      <p class="txt-label padb-100">GRUPNA PRAKSA</p>
      <h2 class="h3 padb-400">Otvorene prijave za kolovoz</h2>
      <p class="body-large padb-900">
        Želiš steći više sigurnosti i samopouzdanja u upravljanju brodicom?
        Pridruži nam se na 5 sati praktične edukacije na moru. <br /><br /> 28.08.
        Petak (14h - 19h) - maks 3 osobe <br /> 29.08. Subota (09h - 14h) - maks 3
        osobe <br />
        <br />
        Cijena: 300€/osoba <br />
        Grupa se formira kad se popune mjesta (3 osobe po tečaju)<br />
        5h sati na moru<br /> Brod, gorivo i instruktor uključeni u cijenu. <br
        />
        <br />
        Napomena: Ancora Spei ne izdaje nikakve dozvole ni licence za voditelja brodice
        već vršimo iskustvo učenja na moru.
      </p>
      <a href="https://forms.gle/Aky9XmintDXXsJ9z5" target="_blank"
        ><div class="btn-fill">PRIJAVA</div></a
      >
    </div>
  </section>
  <!-- grupe -->
  <Image src={franebozo} alt="ancora spei" loading="eager" class="img-full2" />

  <section class="section center wrapper txt-center bg-light clr-ter-acc">
    <p class="txt-label padb-100">PLOVITE BEZ STRESA</p>
    <h2 class="h3 padb-400">Samostalno upravljajte brodicom</h2>
    <p class="body-large padb-900">
      Nudimo uslugu praktične edukacije na moru bez obzira jeste li vlasnik
      plovila ili ne. Mi osiguravamo sve potrebno da biste na kraju tečaja bili
      sposobni i sigurni u plovidbi brodicom.
    </p>
    <a href="/usluge/"><div class="btn-fill">USLUGE</div></a>
  </section>

  <!-- testimonials -->

  <!-- img -->
  <section class="hidden-fade section">
    <Image src={boat} alt="ancora spei" loading="eager" class="img-full2" />
  </section>

  <!-- cta 1-->
  <section class="center bg-light clr-ter-acc">
    <div class="wrapper-medium center txt-center section-2">
      <p class="txt-label padb-100 hidden-fade delay1">ISKUSTVO NA MORU</p>
      <h2 class="h3 padb-400 hidden-fade delay2">
        Profesionalni instruktori sa dugogodišnjim iskustvom
      </h2>
      <p class="body-large padb-900 hidden-fade delay3">
        Ancora Spei nudi individualni pristup prema svakom klijentu i njegovim
        potrebama. Naš cilj je prenijeti znanje ali i podijeliti stvarno
        iskustvo i ljubav prema moru. Naši instruktori imaju višegodišnje
        maritimno iskustvo upravljanja raznim brodicama u svim vremenskim
        uvjetima na Jadranskom moru.
      </p>
      <a href="/kontakt/"><div class="btn-fill">KONTAKT</div></a>
    </div>
  </section>

  <!-- img -->
  <section class="hidden-fade section">
    <Image src={pajet} alt="ancora spei" loading="eager" class="img-full2" />
  </section>

  <!-- cta 2-->
  <section class="center section bg-light clr-ter-acc">
    <div class="wrapper-medium center txt-center section-2">
      <p class="txt-label padb-100 hidden-fade delay1">
        ZNANJE KOJE SE STJEČE NA MORU
      </p>
      <h2 class="h3 padb-400 hidden-fade delay2">
        Ovladajte vještinama koje se ne stječu učenjem iz knjige
      </h2>
      <p class="body-large padb-900 hidden-fade delay3">
        Učenje je nepotpuno bez prave prakse. Zaplovite s nama i pretvorite
        teorijsko znanje u praktične vještine koje će vam dati sigurnost,
        samopouzdanje i spremnost za samostalnu plovidbu.
      </p>
      <a href="/usluge/"><div class="btn-fill">USLUGE</div></a>
    </div>
  </section>
</MainLayout>

<script>
  import "../scripts/slider.js";
  import "../scripts/accordion.js";
</script>
