---
//Main Layout
import MainLayout from "../layouts/MainLayoutHR.astro";

//import main site data
import siteInfo from "../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";
import hero from "../images/default/seo.jpg";
import logo from "../images/logos/zid_logo_full_accent.svg";
import apartment1 from "../images/hero/apartment1.jpg";
import apartment2 from "../images/hero/apartment2.jpg";
import apartment3 from "../images/hero/apartment3.jpg";

//import images

//import icons
import { Icon } from "astro-icon/components";

//import components

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexEn=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="center hero-full hero-home">
    <div class="container wrapper center">
      <Image
        src={logo}
        alt="zid interior design full logo"
        format="avif"
        loading="eager"
        id="heroLogo"
      />
      <h1 class="h1 padb-800">
        Dizajn po vašoj<span class="italic clr-prim-acc"> mjeri</span>
      </h1>
      <p>uredi svoj dom</p>
    </div>
  </section>

  <!-- example section -->
  <section class="examples">
    <div class="wrapper">
      <p class="txt-label upper txt-center clr-prim-acc padb-400">
        umjetnost & dom
      </p>
      <h2 class="h2 txt-center padb-800">
        Kvalitetno dizajniran dom <br /> je <span class="italic clr-prim-acc"
          >umjetničko djelo</span
        >
      </h2>
    </div>
    <div class="wrapper-medium center">
      <p class="body-large center padb-800">
        Lorem ipsum dolor sit, amet consectetur adipisicing elit. Earum culpa
        velit, fugiat adipisci repudiandae obcaecati id tempore a officiis modi
        nulla quaerat nostrum magni possimus totam voluptate. Adipisci, optio
        officia?
      </p>
    </div>
    <div class="columns wrapper center">
      <div class="box">
        <Image
          src={apartment1}
          alt="zid interior apartment design"
          format="webp"
          loading="eager"
        />
      </div>
      <div class="box">
        <Image
          src={apartment2}
          alt="zid interior apartment design"
          format="webp"
          loading="eager"
        />
      </div>
      <div class="box">
        <Image
          src={apartment3}
          alt="zid interior apartment design"
          format="webp"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- message-->
  <section class="message">
    <div class="wrapper center">
      <div class="container">
        <div class="box">
          <h2 class="title">
            kreiramo vaš <span class="italic">dom </span>iz snova
          </h2>
        </div>
        <div class="box">
          <p class="padb-600">
            Lorem, ipsum dolor sit amet consectetur adipisicing elit. Vel
            deleniti quas distinctio eos culpa voluptate, reiciendis
            necessitatibus accusamus earum porro aperiam eius nesciunt quam,
            beatae dolorem cum dolores facilis iusto!
          </p>
          <div class="btn-fill">KONTAKT</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ-->
  <section class="faq">
    <div class="wrapper-medium center">
      <div class="container">
        <h2 class="h2 padb-400">Česta pitanja</h2>
        <p class="body-large padb-400">
          Ako se niste prije susreli sa nama osobno ili ste novi u svijetu
          dizajna interijera, ova pitanja Vam mogu pomoći.
        </p>
        <div class="question">
          <div class="accordion">
            Čime se bavite?<Icon
              class="faq-icon"
              name="mdi:plus"
              width={28}
              height={28}
            />
          </div>

          <div class="panel">
            <p class="body">
              Lorem ipsum dolor sit amet consectetur adipisicing elit. Ab error,
