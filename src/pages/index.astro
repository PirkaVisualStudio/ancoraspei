---
//Main Layout
import MainLayout from "../layouts/MainLayoutEN.astro";

//import main site data
import siteInfo from "../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images

import hero from "../images/hero/hero3.jpg";
import tece from "../images/hero/tece.jpg";
import kuzina from "../images/hero/kuzina.jpg";
import vila from "../images/hero/vilaLQ.jpg";
import vila2 from "../images/hero/vila2.jpg";
import logo from "../images/logos/pusti_logo_ext_light.svg";

//import icons
import { Icon } from "astro-icon/components";

//import components
import PhotoSlider from "../components/elements/PhotoSlider.astro";
import ReviewsSlider from "../components/elements/TestimonialsHR.astro";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexHr=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="center hero-home">
    <div class="hero-mask">
      <Image
        src={hero}
        alt="pusti me proc"
        loading="eager"
        class="hero_image"
      />
    </div>
    <div class="container wrapper">
      <Image
        src={logo}
        alt="pusti me proc logo"
        loading="eager"
        id="heroLogo"
      />

      <div class="hero-cta-btn">
        <a href="https://pustimeproc.hr/menu/" target="_blank"
          ><div class="btn-fill">BOOK NOW</div></a
        >
        <a href="/menu/"><div class="btn-fill">MENU</div></a>
      </div>
    </div>
  </section>

  <!-- services -->

  <section class="section center wrapper txt-center bg-light clr-ter-acc">
    <p class="txt-label padb-400">LET ME PASS</p>
    <h1 class="h3 padb-100">Authentic food in a heart of Split</h1>
    <p class="body-large padb-900">
      A restaurant inspired by one of the narrowest streets in Split, where
      getting stuck is part of the experience.
    </p>
    <a href="/menu/"><div class="btn-fill">MENU</div></a>
  </section>

  <!-- testimonials -->

  <ReviewsSlider />

  <!-- img -->
  <section class="hidden-fade section">
    <Image src={tece} alt="pusti me proc" loading="eager" class="img-full2" />
  </section>

  <!-- cta 1-->
  <section class="center bg-light clr-ter-acc">
    <div class="wrapper-medium center txt-center section-2">
      <p class="txt-label padb-400 hidden-fade delay1">PAUSE HERE</p>
      <h2 class="h3 padb-400 hidden-fade delay2">Life moves slow</h2>
      <p class="body-large padb-900 hidden-fade delay3">
        Enjoy our authentic Croatian food in a cozy atmosphere
      </p>
      <a href="/contact/"><div class="btn-fill">CONTACT</div></a>
    </div>
  </section>

  <!-- img -->
  <section class="hidden-fade section">
    <Image
      src={kuzina}
      alt="pusti me proc kuzina"
      loading="eager"
      class="img-full2"
    />
  </section>

  <!-- cta 2-->
  <section class="center section bg-light clr-ter-acc">
    <div class="wrapper-medium center txt-center section-2">
      <p class="txt-label padb-400 hidden-fade delay1">THE FOOD CHOICE</p>
      <h2 class="h3 padb-400 hidden-fade delay2">Check out our menu!</h2>
      <p class="body-large padb-900 hidden-fade delay3">
        Check out our menu and find out our prices.
      </p>
      <a href="/menu/"><div class="btn-fill">MENU</div></a>
    </div>
  </section>
</MainLayout>

<script>
  import "../scripts/slider.js";
  import "../scripts/accordion.js";
</script>
