---
//Main Layout
import MainLayout from "../layouts/MainLayoutHR.astro";

//import main site data
import siteInfo from "../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";

//import images
import logo from "../images/logos/pirka_logo_acc.svg";
import peskarija from "../images/hero/peskarija.jpg";
import billboard from "../images/hero/billboard.jpg";

import vine from "../videos/wine tasting.mp4";

//import icons
import { Icon } from "astro-icon/components";

//import components

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  brandTitle,
  pageIndex=""
  pageIndexEn=""
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <!-- hero -->
  <section class="center hero-home flex-column bg-dark">
    <div class="container wrapper center">
      <Image
        src={logo}
        alt="pirka visual design logotip"
        loading="eager"
        id="heroLogo"
      />
    </div>
  </section>

  <!-- video -->
  <section class="videos bg-dark">
    <div class="container">
      <video loop autoplay muted class="video">
        <source src={vine} type="video/mp4" />
      </video>

      <video loop autoplay muted class="video">
        <source src={vine} type="video/mp4" />
      </video>

      <video loop autoplay muted class="video">
        <source src={vine} type="video/mp4" />
      </video>
    </div>
  </section>

  <!-- image -->
  <section class="center bg-dark">
    <div class="container center">
      <Image
        src={billboard}
        alt="pirka visual design logotip"
        loading="eager"
        class="img-full"
      />
    </div>
  </section>
</MainLayout>
