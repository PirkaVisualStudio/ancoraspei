---
import MainLayout from "../layouts/MainLayout.astro";

//image compression
import { Image } from "astro:assets";
import hero from "../images/hero/hero2.jpg";
import services from "../images/media/services.jpg";
import destinations from "../images/media/destinations.jpg";
import woman from "../images/media/woman-boat.jpg";

//icons
import { Icon } from "astro-icon";

const {
  title,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang="en"
  pageIndex="luxury-trips"
  pageIndexEn="luxury-trips"
  title="Luxury trips | Elamio Yachting"
  charset={charset}
  description="Enjoy our luxurious trips around the Croatian islands | Elamio Yachting"
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
  noindex
  nofollow
>
  <div class="hero_content txtOnDark txt-center flex-center">
    <div class="black"></div>
    <Image
      src={services}
      alt="boat"
      format="avif"
      loading="lazy"
      class="hero-img"
    />
    <div class="heroContainer-default">
      <h1 class="h1">Luxury tailor made trips</h1>

      <h2 class="body">Croatia's most wanted islands are waiting</h2>
    </div>
  </div>
</MainLayout>
