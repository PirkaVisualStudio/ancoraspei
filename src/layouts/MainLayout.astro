---
import Head from "../components/Head.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";

//import data
import siteInfo from "../data/siteInfo.json";

//image compression
import { Image } from "astro:assets";
import defaultImage from "../images/hero/hero4.jpg";

const { pageIndex } = Astro.props;
const { pageIndexEn } = Astro.props;
const { lang } = Astro.props;

const {
  title = `${siteInfo.map((i) => i.title)}`,
  charset = `${siteInfo.map((i) => i.charset)}`,
  description = `${siteInfo.map((i) => i.description)}`,
  canonical = Astro.url,
  noindex,
  nofollow,
  openGraph = {
    basic: {
      title: `${title}`,
      type: "website",
      image: defaultImage.src,
    },
  },
  languageAlternates = [
    {
      href: Astro.site + `${pageIndex}`,
      hrefLang: "en",
    },
  ],
  extend = {
    meta: [
      {
        name: "author",
        content: "Pirka Visual Studio",
      },

      {
        name: "keywords",
        content:
          "keyword1, keyword2, keyword3, keyword4, keyword5, keyword6, keyword7",
      },
    ],
  },
} = Astro.props;
---

<Head
  {lang}
  {title}
  {charset}
  {description}
  {canonical}
  {noindex}
  {nofollow}
  {openGraph}
  {languageAlternates}
  {extend}
/>

<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript
    ><iframe
      src={"https://www.googletagmanager.com/ns.html?id=" +
        `${siteInfo.map((i) => i.google_id)}`}
      height="0"
      width="0"
      style="display:none;visibility:hidden"></iframe></noscript
  >
  <!-- End Google Tag Manager (noscript) -->
  <CookieBanner />
  <Nav />

  <main>
    <slot />
  </main>

  <Footer />

  <script>
    import "../scripts/navTop.js";
    import "../scripts/animation.js";
  </script>

  <script is:inline src="/scripts/consent.js"></script>
</body>
