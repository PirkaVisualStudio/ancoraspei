---
//icons
import { Icon } from "astro-icon/components";

const today = new Date();

//import menu data
import navMenu from "../data/navMenuHR.json";

//image compression
import { Image } from "astro:assets";
import logoBadge from "../images/logos/pirka_logo_nav_acc.svg";
import navLogo from "../images/logos/ancora_logo_icon_prim.svg";
---

<footer>
  <section class="container">
    <div class="wrapper center">
      <Image src={navLogo} alt="pusti me proc logo" id="footerLogo" />
      <p class="h6 txt-bold upper padb-400">
        Praktična edukacija za sigurno upravljanje plovilom
      </p>
      <p class="body-bold padb-100">KONTAKT INFORMACIJE</p>
      <p class="padb-100">
        mail: <a href="mailto:info@ancoraspei.hr">info@ancoraspei.hr</a>
      </p>
      <p class="padb-100">
        Frane Miro Dobrović: <a href="tel:00385922897458">+385 92 289 7458</a>
      </p>

      <p class="padb-400">
        Božidar Križanović: <a href="tel:0038598539884">+385 98 539 884</a>
      </p>
      <div>
        <a
          href="https://www.instagram.com/ancoraspeiboating/"
          target="_blank"
          aria-label="Link to Instagram page"
          ><Icon
            class="socialNavIcon"
            name="ri:instagram-fill"
            width={28}
            height={28}
          /></a
        >
        <a
          href="https://facebook.com/profile.php?id=61593271377088"
          target="_blank"
          aria-label="Link to Facebook page"
          ><Icon
            class="socialNavIcon"
            name="ant-design:facebook-filled"
            width={28}
            height={28}
          /></a
        >
      </div>
    </div>
  </section>

  <section class="wrapper center">
    <hr class="marb-100" />
    <div class="copyright">
      <div>
        <p class="txt-label padb-100">
          &copy; Ancora Spei | {today.getFullYear()} | Design by <a
            href="https://pirka.hr"
            target="_blank">Pirka</a
          >
        </p>
        <a class="body-small" href="/polica/">Polica privatnosti</a>
      </div>

      <div class="social-footer">
        <div class="language-selector">
          <a href="/en/" class="lang-active">EN</a> | <a href="/">HR</a>
        </div>
      </div>
    </div>
  </section>
</footer>
