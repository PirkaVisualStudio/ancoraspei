---
//icons
import { Icon } from "astro-icon/components";

const today = new Date();

//import menu data
import navMenu from "../data/navMenuHR.json";

//image compression
import { Image } from "astro:assets";
import logoBadge from "../images/logos/zid_icon_dark.svg";
---

<footer>
  <section class="footer clr-main-dark">
    <div class="footer-container wrapper center">
      <div class="footer-logo padt-700 flex-center">
        <Image
          src={logoBadge}
          alt="pirka visual design"
          format="avif"
          loading="eager"
          id="footerLogo"
        />
      </div>
    </div>

    <div class="txt-center wrapper center section">
      <hr class="marb-100" />
      <p class="txtLabel padb-100">
        &copy; Zorana Interior Design | {today.getFullYear()} | Design by <a
          href="https://pirka.hr"
          target="_blank">Pirka Visual Studio</a
        >
      </p>
      <a class="body-small" href="/polica/"> &nbspPravila privatnosti</a>
    </div>
  </section>
</footer>
