<div id="cookie-consent-banner" class="cookie-consent-banner">
  <div class="wrapper mart-500 marb-500">
    <h3 class="h3 padb-100">Cookie settings</h3>
    <p class="body-small">
      We use cookies to provide you with the best possible experience. They also
      help us to analyze user behaviour.
    </p>
    <div class="padt-200">
      <button id="btn-accept-all" class="cookie-consent-button btn-success"
        >Accept all</button
      >

      <button id="btn-accept-some" class="cookie-consent-button btn-outline"
        >Accept selection</button
      >

      <button id="btn-reject-all" class="cookie-consent-button btn-grayscale"
        >Reject all</button
      >
    </div>

    <div class="cookie-consent-options padt-100">
      <label
        ><input
          id="consent-necessary"
          type="checkbox"
          value="Necessary"
          checked
          disabled
        />Necessary</label
      >

      <label
        ><input
          id="consent-analytics"
          type="checkbox"
          value="Analytics"
          checked
        />Analytics</label
      >

      <label
        ><input
          id="consent-personalization"
          type="checkbox"
          value="Ad personalization"
          checked
        />Ad personalization</label
      >

      <label
        ><input
          id="consent-marketing"
          type="checkbox"
          value="Marketing"
          checked
        />Marketing</label
      >
    </div>
  </div>
</div>
