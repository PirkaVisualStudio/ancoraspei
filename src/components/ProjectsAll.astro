---
//image compression
import { Image } from "astro:assets";

//projects collections
import { getCollection, type CollectionEntry } from "astro:content";
const projectPosts = await getCollection("projects", ({ data }) => {
  return !data.draft;
});

//Slider css
import "@splidejs/splide/css/sea-green";

//import icons
import { Icon } from "astro-icon/components";
---

<section id="projects">
  <div class="wrapper center"><hr /></div>
  {
    projectPosts.map((post) => (
      <>
        <div class="project-container wrapper center flex-column hidden-fade">
          <div class="flex-left">
            <div class="project-title">
              <p class="txt-label padb-100 clr-prim-acc">
                {post.data.category}
              </p>
              <h2 class="h4 padb-100">{post.data.title}</h2>
              <p class="txt-label padb-200 clr-prim-acc">{post.data.year}</p>
              <p class="padb-400 justify">{post.data.description}</p>
              <a href={`/projekti/${post.slug}/`}>
                <div class="btn-fill">VIŠE</div>
              </a>
            </div>
          </div>
          <div class="flex-right">
            <a href={`/projekti/${post.slug}/`}>
              {" "}
              <Image
                src={post.data.image}
                alt="alo"
                format="avif"
                loading="eager"
              />
            </a>
          </div>
        </div>
        <div class="wrapper center">
          <hr />
        </div>
      </>
    ))
  }
</section>
