---
//image compression
import { Image } from "astro:assets";

//Slider css
import "@splidejs/splide/css";

//icons
import { Icon } from "astro-icon";

//md data
import { getCollection } from "astro:content";

const reviewPost = await getCollection("reviews");
---

<div class="section">
  <section
    class="splide slider-custom hidden-fade wrapper center marb-900"
    id="splideReviews"
    aria-label="splide2"
  >
    <div class="splide__slider">
      <div class="splide__track">
        <ul class="splide__list">
          {
            reviewPost.map((i) => (
              <li class="splide__slide">
                <div class="txtOnDark center">
                  <p class="padb-400 body-large">{i.data.short}</p>
                  <p class="script-font padb-100">{i.data.name}</p>
                  <p class="upper font-heading">{i.data.from}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <!-- Add the progress bar element 
    <div class="my-carousel-progress">
      <div class="my-carousel-progress-bar mart-900"></div>
    </div>-->
    </div>
  </section>
</div>
