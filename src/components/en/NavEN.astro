          <div class="nav-link dropdown-button">
            usluge
            <Icon
              class="dropdown-arrow"
              pack="mdi"
              name="chevron-down"
              width="20"
            />
          </div>

          <div class="dropdown-container">
            <div class="dropdown-content">
              <div class="dropdown-group">
                <ul class="dropdown-list">
                  <a href="/usluge/videoprodukcija/" class="dropdown-link"
                    ><li></li>Video produkcija</a
                  >
                  <a href="/usluge/fotografija/" class="dropdown-link"
                    ><li></li>Fotografija</a
                  >
                  <a href="/usluge/dizajn/" class="dropdown-link"
                    ><li></li>Dizajn</a
                  >
                  <a href="/usluge/marketing/" class="dropdown-link"
                    ><li></li>Digitalni marketing</a
                  >
                </ul>
              </div>
            </div>
          </div>
        </li>-->
      </ul>
    </div>

    <div class="socialNav">
      <div class="btn-nav-action-rounded">GET QUOTE</div>
      <div class="language-selector">
        <a href="/en/">EN</a> | <a href="/">HR</a>
      </div>
      <div class="social-nav">
        <a href="#" target="_blank"
          ><Icon
            class="socialNavIcon"
            name="ri:instagram-fill"
            width={28}
            height={28}
          /></a
        >
        <a href="#" target="_blank"
          ><Icon
            class="socialNavIcon"
            name="ant-design:facebook-filled"
            width={28}
            height={28}
          /></a
        >
      </div>
    </div>
  </nav>
</header>
