---
//import icons
import { Icon } from "astro-icon/components";

//import menu data
import navMenu from "../../data/navMenuEN.json";
---

<header
  id="navBar"
  class="nav-bar"
  data-scroll
  data-scroll-repeat
  data-scroll-ignore-fold
  data-scroll-offset="-15%,-15%"
  data-scroll-position="end,start"
  data-scroll-call="scrollNavColor"
>
  <nav
    class="nav wrapper center noSelect"
    id="navMenu"
    data-scroll
    data-scroll-repeat
    data-scroll-ignore-fold
    data-scroll-offset="-10%,-10%"
    data-scroll-position="end,start"
    data-scroll-call="scrollNavHeight"
  >
    <div class="nav-data">
      <div class="logo-container">
        <a href="/" class="nav-logo">
          <img
            id="headerLogo"
            src="..//images/logos/pirkalogo_dark.svg"
            alt="pirka logo icon dark"
          />
        </a>
      </div>
      <div class="nav-toggle" id="navToggle">
        <Icon class="nav-toggle-menu" name="mdi:menu" width={28} height={28} />
        <Icon
          class="nav-toggle-close"
          name="mdi:close"
          width={28}
          height={28}
        />
      </div>
    </div>

    <div class="nav-menu" id="listId">
      <ul class="nav-list wrapper" id="navList">
        {
          navMenu.map((i) => (
            <a href={i.path}>
              <li class="nav-link">{i.name}</li>
            </a>
          ))
        }

        <!-- ============= DROPDOWN ITEM 01 ============= 

