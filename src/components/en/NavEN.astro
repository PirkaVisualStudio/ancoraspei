---
//import icons
import { Icon } from "astro-icon/components";

//import menu data
import navMenu from "../../data/navMenuEN.json";

//image compression
import { Image } from "astro:assets";
import navLogo from "../../images/logos/maven_logo_dark.svg";
import navLogo2 from "../../images/logos/maven_logo_light.svg";
---

<header
  id="navBar"
  class="nav-bar"
  data-scroll
  data-scroll-repeat
  data-scroll-ignore-fold
  data-scroll-offset="-100%,-100%"
  data-scroll-position="end,start"
  data-scroll-call="scrollNavRemove"
>
  <nav
    class="nav noSelect"
    id="navMenu"
    data-scroll
    data-scroll-repeat
    data-scroll-ignore-fold
    data-scroll-offset="-10%,-10%"
    data-scroll-position="end,start"
    data-scroll-call="scrollNavChange"
  >
    <div class="mobile-menu" id="mobileId">
      <div class="mobile-container">
        <ul class="mobile-list wrapper">
          {
            navMenu.map((i) => (
              <li class="mobile-link">
                <a href={i.path}>{i.name}</a>
              </li>
            ))
          }
          <!-- ============= DROPDOWN ITEM 01 ============= 
          <li class="dropdown-item">
            <div class="nav-link dropdown-button">
              usluge
              <Icon class="dropdown-arrow" name="mdi:chevron-down" />
            </div>

            <div class="dropdown-container">
              <div class="dropdown-content">
                <div class="dropdown-group">
                  <ul class="dropdown-list">
                    <a href="/usluge/videoprodukcija/"
                      ><li class="dropdown-link">Video produkcija</li></a
                    >
                    <a href="/usluge/fotografija/"
                      ><li class="dropdown-link">Fotografija</li></a
                    >
                    <a href="/usluge/dizajn/"
                      ><li class="dropdown-link">Dizajn</li></a
                    >
                    <a href="/usluge/marketing/"
                      ><li class="dropdown-link">Digitalni marketing</li></a
                    >
                  </ul>
                </div>
              </div>
            </div>
          </li>-->
        </ul>
      </div>
      <div class="mobile-low-section wrapper">
        <p class="h4">MENU</p>
      </div>
    </div>
    <div class="container wrapper center">
      <div class="logo logo-dark">
        <a href="/">
          <Image src={navLogo} alt="maven logo submark" />
        </a>
      </div>
      <div class="logo logo-light">
        <a href="/">
          <Image src={navLogo2} alt="maven logo submark" />
        </a>
      </div>

      <div class="nav-menu">
        <ul class="nav-list">
          {
            navMenu.map((i) => (
              <li class="nav-link">
                <a href={i.path}>{i.name}</a>
              </li>
            ))
          }
          <!-- ============= DROPDOWN ITEM 01 ============= 
          <li class="dropdown-item">
            <div class="nav-link dropdown-button">
              usluge
              <Icon class="dropdown-arrow" name="mdi:chevron-down" />
            </div>

            <div class="dropdown-container">
              <div class="dropdown-content">
                <div class="dropdown-group">
                  <ul class="dropdown-list">
                    <a href="/usluge/videoprodukcija/"
                      ><li class="dropdown-link">Video produkcija</li></a
                    >
                    <a href="/usluge/fotografija/"
                      ><li class="dropdown-link">Fotografija</li></a
                    >
                    <a href="/usluge/dizajn/"
                      ><li class="dropdown-link">Digitalni marketing</li></a
                    >
                    <a href="/usluge/marketing/"
                      ><li class="dropdown-link">Dizajn</li></a
                    >
                  </ul>
                </div>
              </div>
            </div>
          </li>-->
        </ul>
      </div>

      <div class="social-nav">
        <div class="theme">
          <button
            id="theme-toggle"
            class="theme-switcher"
            aria-label="Toggle theme"
          >
            <Icon
              name="material-symbols:moon-stars-rounded"
              width={24}
              height={24}
              class="moon"
            />
            <Icon
              name="material-symbols:wb-sunny-outline-rounded"
              width={24}
              height={24}
              class="sun"
            />
          </button>
        </div>
        <div class="language-selector body-bold">
          <button id="to-en">EN</button>
          <p>|</p>

          <button id="to-hr">HR</button>

          <!--  
          <a href="/" class="lang-active" id="to-en">EN</a> | <a
            href="/hr/"
            id="to-hr">HR</a
          >-->
        </div>
        <div class="social-icons">
          <a
            href="https://www.instagram.com/pirkavisualstudio/"
            target="_blank"
            aria-label="Link to Instagram page"
            ><Icon
              class="socialNavIcon"
              name="ri:instagram-fill"
              width={28}
              height={28}
            /></a
          >
          <a
            href="https://www.facebook.com/pirkavisualstudio"
            target="_blank"
            aria-label="Link to Facebook page"
            ><Icon
              class="socialNavIcon"
              name="ant-design:facebook-filled"
              width={28}
              height={28}
            /></a
          >
        </div>
      </div>

      <div class="nav-toggle" id="navToggle">
        <Icon class="nav-toggle-menu" name="mdi:menu" width={28} height={28} />
        <Icon
          class="nav-toggle-close"
          name="mdi:close"
          width={28}
          height={28}
        />
      </div>
    </div>
  </nav>
</header>
