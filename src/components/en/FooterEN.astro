---
//icons
import { Icon } from "astro-icon/components";

const today = new Date();

//import menu data
import navMenu from "../../data/navMenuEN.json";

//image compression
import { Image } from "astro:assets";
import logoBadge from "../../images/logos/pirka_logo_nav_acc.svg";
import navLogo from "../../images/logos/pusti_logo_light.svg";
---

<footer>
  <section class="container">
    <div class="wrapper center">
      <Image src={navLogo} alt="pusti me proc logo" id="footerLogo" />
      <p class="h6 txt-bold upper padb-400">
        Authentic food in a hearth of Split.
      </p>
      <div>
        <a
          href="https://www.instagram.com/pirkavisualstudio/"
          target="_blank"
          aria-label="Link to Instagram page"
          ><Icon
            class="socialNavIcon"
            name="ri:instagram-fill"
            width={28}
            height={28}
          /></a
        >
        <a
          href="https://www.facebook.com/pirkavisualstudio"
          target="_blank"
          aria-label="Link to Facebook page"
          ><Icon
            class="socialNavIcon"
            name="ant-design:facebook-filled"
            width={28}
            height={28}
          /></a
        >
      </div>
    </div>
  </section>

  <section class="wrapper center">
    <hr class="marb-100" />
    <div class="copyright">
      <div>
        <p class="txt-label padb-100">
          &copy; Pusti me proć | {today.getFullYear()} | Design by <a
            href="https://pirka.hr"
            target="_blank">Pirka</a
          >
        </p>
        <a class="body-small" href="/polica/">Privacy policy</a>
      </div>

      <div class="social-footer">
        <div class="language-selector">
          <a href="/en/" class="lang-active">EN</a> | <a href="/">HR</a>
        </div>
      </div>
    </div>
  </section>
</footer>
