---
//image compression
import { Image } from "astro:assets";

import hero from "../images/hero/hero.jpg";
---

<div class="section bg-dark txtOnDark txt-center" id="gallery">
  <h2 class="h2 padb-100">Gallery</h2>
  <p class="body wrapper center">View our gallery</p>
  <div class="grid-wrapper wrapper center section">
    <div class="big">
      <Image
        src={hero}
        alt="boat"
        format="avif"
        loading="lazy"
        class="img-gallery hidden-fade"
      />
    </div>

    <div>
      <Image
        src={hero}
        alt="boat"
        format="avif"
        loading="lazy"
        class="img-gallery hidden-fade"
      />
    </div>

    <div>
      <Image
        src={hero}
        alt="boat"
        format="avif"
        loading="lazy"
        class="img-gallery hidden-fade"
      />
    </div>

    <div class="tall">
      <Image
        src={hero}
        alt="boat"
        format="avif"
        loading="lazy"
        class="img-gallery hidden-fade"
      />
    </div>

    <div class="">
      <Image
        src={hero}
        alt="boat"
        format="avif"
        loading="lazy"
        class="img-gallery hidden-fade"
      />
    </div>

    <div class="wide">
      <Image
        src={hero}
        alt="boat"
        format="avif"
        loading="lazy"
        class="img-gallery hidden-fade"
      />
    </div>

    <div>
      <Image
        src={hero}
        alt="boat"
        format="avif"
        loading="lazy"
        class="img-gallery hidden-fade"
      />
    </div>
  </div>
</div>
