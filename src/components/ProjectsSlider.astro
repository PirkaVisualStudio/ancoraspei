---
//image compression
import { Image } from "astro:assets";

//projects collections
import { getCollection, type CollectionEntry } from "astro:content";
const projectPosts = await getCollection("projects", ({ data }) => {
  return !data.draft;
});

//Slider css
import "@splidejs/splide/css/sea-green";

//import icons
import { Icon } from "astro-icon/components";
---

<section class="wrapper center section">
  <div class="title-container">
    <div>
      <h2 class="h1 padb-200 title">Projekti</h2>
      <h3 class="h3 subtitle padb-200">neki od naših projekata</h3>
    </div>

    <a href="/projekti/">
      <div class="btn-stroke-rounded" id="btnFullWidth">Vidi sve</div></a
    >
  </div>
  <hr class="marb-400 mart-400" />

  <div class="splide wrapper center" aria-label="Splide Basic HTML Example">
    <Icon class="arrow-bg-mid-left" name="projectArrowBG" />
    <Icon class="arrow-bg-mid-right" name="projectArrowBG" />
    <div class="splide__track">
      <ul class="splide__list">
        {
          projectPosts.map((post) => (
            <li class="splide__slide">
              <a href={`/projekti/${post.slug}/`}>
                <div class="card-container">
                  <div class="arrow">
                    <Icon class="arrow-bg" name="projectArrowBG" />
                    <Icon class="arrow-icon" name="projectArrow" />
                  </div>

                  <div class="card-img">
                    <div class="overlay" />

                    <Image
                      src={post.data.image}
                      alt={post.data.imageAlt}
                      format="avif"
                      loading="eager"
                    />
                  </div>
                </div>
              </a>

              <div class="padt-300">
                <p class="txt-label font-heading">{post.data.category}</p>
                <p class="body-bold font-heading">{post.data.title}</p>
                <p class="txt-label font-heading">{post.data.year}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
