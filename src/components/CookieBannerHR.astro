<div
  id="cookie-consent-banner"
  class="cookie-consent-banner bg-light txt-on-light"
>
  <div class="wrapper mart-500 marb-500">
    <h3 class="h3 padb-100">Postavke kolačića</h3>
    <p class="body-small">
      Koristimo kolačiće kako bismo Vam pružili najbolje moguće iskustvo.
      Također nam pomažu analizirati ponašanje korisnika.
    </p>
    <div class="padt-200">
      <button
        id="btn-accept-all"
        class="cookie-consent-button btn-success btn-consent marr-100 marb-100"
        >Prihvati sve</button
      >

      <button
        id="btn-accept-some"
        class="cookie-consent-button btn-outline btn-consent-outline marr-100 marb-100"
        >Prihvati odabrano</button
      >

      <button
        id="btn-reject-all"
        class="cookie-consent-button btn-grayscale btn-consent-outline marb-100"
        >Odbij sve</button
      >
    </div>

    <div class="cookie-consent-options padt-100 flex">
      <div>
        <label
          ><input
            id="consent-necessary"
            type="checkbox"
            value="Necessary"
            checked
            disabled
            class="marb-100 marr-100"
          />Obavezni</label
        >
      </div>

      <div>
        <label
          ><input
            id="consent-analytics"
            type="checkbox"
            value="Analytics"
            checked
            class="marb-100 marr-100"
          />Analitika</label
        >
      </div>

      <div>
        <label
          ><input
            id="consent-personalization"
            type="checkbox"
            value="Ad personalization"
            checked
            class="marb-100 marr-100"
          />Personalizacija oglasa</label
        >
      </div>

      <div>
        <label
          ><input
            id="consent-marketing"
            type="checkbox"
            value="Marketing"
            checked
            class="marr-100"
          />Marketing</label
        >
      </div>
    </div>
  </div>
</div>
