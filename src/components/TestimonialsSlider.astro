---
//image compression
import { Image } from "astro:assets";

import hero from "../images/hero/hero.jpg";
import male1 from "../images/media/users/male1.jpg";

//Slider css
import "@splidejs/splide/css";

//icons
import { Icon } from "astro-icon";

//reviews data
import reviewsJSON from "../data/reviews.json";

//md data
import { getCollection } from 'astro:content';

const reviewPost = await getCollection('reviews');
---

<section
  class="splide slider-custom hidden-fade"
  id="splideTestimonials"
  aria-label="splide"
>
  <div class="splide__slider">
    <div class="splide__track">
      <ul class="splide__list">


        
        {reviewPost.map((i) => <li class="splide__slide">
          <div class="txtOnLight testimonial-container">
            <div class="section">
              <div class="wrapper">
                <div class="icon">
                  <Icon name="quotes" class="quotes padb-200" />
                </div>
                <p class="body-large center content">
                  {i.data.short}
                </p>
                <!--  <div class="icon-end">
                <Icon name="quotes" class="quotes-end padb-200" />
              </div>-->
              </div>
            </div>
            <div class="user">
              <div class="user-profile">
                <Image
                  src={i.data.image}
                  alt="male user 1"
                  format="avif"
                  loading="lazy"
                  class=""
                />
              </div>
              <div class="user-content">
                <h3 class="h5">
                  <p class="name body-bold script-font padb-100">{i.data.name}</p>
                  <p class="city">{i.data.from}</p>
                </h3>
              </div>
            </div>
          </div>
        </li>
        )}


        
      </ul>
    </div>
    <!-- Add the progress bar element 
    <div class="my-carousel-progress">
      <div class="my-carousel-progress-bar mart-900"></div>
    </div>-->
  </div>
</section>


