---
//icons
import { Icon } from "astro-icon";

const today = new Date();
---

<footer>
  <section class="footer section bg-dark clr-main-light">
    <div class="footer-container wrapper center">
      <div class="footer-logo padt-700 flex-center">
        <img
          id="footerLogo"
          src="/images/logos/pirka_logo_badge.svg"
          alt="pirka logo"
        />
      </div>
    </div>

    <div class="flex-columns wrapper section center">
      <div class="column-footer section">
        <h3 class="txtLabel padb-100">LOCATION</h3>
        <div class="line-acc-small marb-600"></div>
        <p class="body-bold padb-100">Elamio d.o.o.</p>
        <p class="padb-600">Đorđićeva 24, 21000, Split, Croatia</p>

        <p class="body-bold padb-100">Home port</p>
        <p>Marina Split</p>
      </div>
      <div class="column-footer section">
        <h3 class="txtLabel padb-100">CONTACTS</h3>
        <div class="line-acc-small marb-600"></div>
        <p class="txtLabel padb-100">KARLO MIOLIN</p>
        <p class="body">
          Email: <a href="mailto:miolinkarlo@gmail.com" target="_blank"
            >miolinkarlo@gmail.com</a
          >
        </p>
        <p class="body padb-600">
          Tel: <a href="tel:00385995924976">+ 385 99 592 4976</a>
        </p>

        <p class="txtLabel padb-100">RENATO MIOLIN</p>
        <p class="body">
          Email: <a href="mailto:renatomiolin@gmail.com" target="_blank"
            >renatomiolin@gmail.com</a
          >
        </p>
        <p class="body padb-100">
          Tel: <a href="tel:0038598732136">+ 385 98 732 136</a>
        </p>
      </div>
      <div class="column-footer section">
        <h3 class="txtLabel padb-100">EXPLORE</h3>
        <div class="line-acc-small marb-600"></div>
        <ul class="footer-list">
          <a href="/"><li class="footer-link">Home</li></a>

          <a href="/boat-fleet/"><li class="footer-link">Boat Fleet</li></a>

          <a href="/excursions/"><li class="footer-link">Excursions</li></a>

          <a href="/luxury-trips/"><li class="footer-link">Tailor made</li></a>

          <a href="/cruises/"><li class="footer-link">Cruises</li></a>

          <a href="/gallery/"><li class="footer-link">Gallery</li></a>

          <a href="/reviews/"><li class="footer-link">Reviews</li></a>

          <a href="/contact/"><li class="footer-link">Contact</li></a>
        </ul>
      </div>

      <div class="column-footer section">
        <h3 class="txtLabel padb-100">SOCIAL</h3>
        <div class="line-acc-small marb-600"></div>
        <div class="footer-social padb-100">
          <a href="https://www.instagram.com/elamio/" target="_blank"
            ><Icon
              class="socialNavIcon"
              pack="ri"
              name="instagram-fill"
              width="28"
            /></a
          >
          <a href="https://www.facebook.com/elamio" target="_blank"
            ><Icon
              class="socialNavIcon"
              pack="ant-design"
              name="facebook-filled"
              width="30"
            /></a
          >
        </div>
      </div>
    </div>

    <div class="txt-center wrapper center">
      <hr class="marb-100" />
      <p class="txtLabel padb-100">
        Copyright Elamio Yachting&copy; | {today.getFullYear()} | Design by <a
          href="http://pirka.hr"
          target="_blank">Pirka Visual Studio</a
        >
      </p>
      <a class="body-small" href="/polica/"> &nbspPravila privatnosti</a>
    </div>
  </section>
</footer>
