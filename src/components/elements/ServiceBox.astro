---
//image compression
import { Image } from "astro:assets";
//import icons
import { Icon } from "astro-icon/components";

const { icon, category, title, desc, imageSrc, imageAlt } = Astro.props;
---

<div class="clr-main-light service-box-container">
  <div class="image">
    <Image src={imageSrc} alt={imageAlt} format="avif" loading="eager" />
  </div>
  <div class="category padb-200">
    <Icon name={icon} width={28} height={28} />
    <p class="body-bold upper">{category}</p>
  </div>
  <h1 class="h3 padb-200">{title}</h1>
  <p class="body">
    {desc}
  </p>
  <div>
    <a href="/usluge/" class="link">
      <p class="txt-label">Saznaj više</p><Icon
        name="mdi:arrow-right"
        width={28}
      /></a
    >
  </div>
</div>
