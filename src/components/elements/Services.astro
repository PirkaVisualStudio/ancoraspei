---
//image compression
import { Image } from "astro:assets";
//import icons
import { Icon } from "astro-icon/components";

const { title, desc, imageSrc, imageAlt } = Astro.props;
---

<div class="clr-main-light service-box-container">
  <div class="image">
    <Image src={imageSrc} alt={imageAlt} format="avif" loading="eager" />
  </div>

  <h1 class="h4 padb-200 title">{title}</h1>
  <p class="body desc">
    {desc}
  </p>
