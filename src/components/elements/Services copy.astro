---
//image compression
import { Image } from "astro:assets";

//import icons
import { Icon } from "astro-icon/components";

const { icon, category, title, desc, imageSrc, imageAlt } = Astro.props;
---

<section class="services wrapper center flex-column marb-200">
  <div class="container">
    <div class="title h6">{title}</div>
    <Image src={imageSrc} alt={imageAlt} format="avif" loading="eager" />
  </div>
</section>
