---
//image compression
import { Image } from "astro:assets";
//import icons
import { Icon } from "astro-icon/components";

const { icon, category, title, desc, imageSrc, imageAlt } = Astro.props;
---

<Image src={imageSrc} alt={imageAlt} format="avif" loading="eager" />
<h2 class="h5 padt-200">{title}</h2>
<p class="body">{desc}</p>
