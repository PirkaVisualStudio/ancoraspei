---
import MainLayout from "../layouts/MainLayoutHR.astro";

//image compression
import { Image } from "astro:assets";

//import icons
import { Icon } from "astro-icon/components";

const {
  title,
  lang,
  charset,
  description,
  canonical,
  noindex,
  nofollow,
  openGraph,
  languageAlternates,
  extend,
} = Astro.props;
---

<MainLayout
  lang={lang}
  pageIndex="hvala"
  pageIndexEn="thanks"
  title={title}
  charset={charset}
  description={description}
  canonical={canonical}
  openGraph={openGraph}
  extend={extend}
>
  <section class="section-nav wrapper center">
    <div class="section">
      <h1 class="h2 padt-900">Hvala</h1>
      <p class="body padb-200">
        Vaš upit je poslan, pokušat ćemo odgovoriti u što kraćem roku.
      </p>
      <a href="/">NATRAG</a>
    </div>
  </section>
</MainLayout>
